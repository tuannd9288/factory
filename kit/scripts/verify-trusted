#!/usr/bin/env bash
# The gate's mechanical check of every pull request, run from main's checkout so the candidate cannot edit it: the
# `verify` job of gate-trusted.yml.
#   scripts/verify-trusted <candidate-dir> <base-sha>
# 1. Main's copy of every .gate/protected path that differs is laid over a copy of the candidate, and main's verify
#    and red-check run there, from the merge-base: the candidate's code under main's policy.
# 2. When the candidate itself changes a protected path, its own checks must still fail on main's fixtures
#    (prove-check --tree). Its scripts are the thing under test here, run by main's prove-check on main's fixtures, so
#    a verify replaced by `exit 0` or a check switched off is caught before the Human is asked to approve it.
# Candidate code runs in this job: it holds no secret and no token. GATE_BODY_FILE names a file holding the PR body,
# for red-check's No-red line.
set -uo pipefail
trusted=$(git rev-parse --show-toplevel) || exit 2
candidate=$(cd "${1:?candidate checkout}" && pwd) || exit 2
base=${2:?base sha}
cd "$trusted" || exit 2

fork=$(git -C "$candidate" merge-base "$base" HEAD) || { echo "verify-trusted: the candidate shares no history with $base"; exit 2; }
differs=$(git -C "$candidate" -c core.quotePath=false diff --name-only --no-renames "$base" HEAD) || { echo "verify-trusted: could not diff the candidate against $base"; exit 2; }
overlay=$(printf '%s\n' "$differs" | node scripts/lib/policy.mjs protected) || { echo "verify-trusted: $overlay"; exit 2; }
own=$(git -C "$candidate" -c core.quotePath=false diff --name-only --no-renames "$fork" HEAD | node scripts/lib/policy.mjs protected) || exit 2
if [ -n "$own" ]; then
  echo "verify-trusted: the change touches protected paths:"
  printf '%s\n' "$own" | sed 's/^/  /'
fi

work=$(mktemp -d) || exit 2
trap 'git -C "$candidate" worktree prune >/dev/null 2>&1; rm -rf "$work"' EXIT
status=0

git -C "$candidate" worktree add --detach --quiet "$work/overlay" HEAD || exit 2
(
  cd "$work/overlay" || exit 2
  [ -n "$overlay" ] && printf '%s\n' "$overlay" | while IFS= read -r path; do
    if git -C "$trusted" cat-file -e "HEAD:$path" 2>/dev/null; then
      mkdir -p "$(dirname "$path")" && git -C "$trusted" show "HEAD:$path" >"$path"
      [ -x "$trusted/$path" ] && chmod +x "$path"
    else
      rm -f "$path"
    fi
  done
  git add -A && GIT_CONFIG_COUNT=3 GIT_CONFIG_KEY_0=user.name GIT_CONFIG_VALUE_0=gate GIT_CONFIG_KEY_1=user.email \
    GIT_CONFIG_VALUE_1=gate@localhost GIT_CONFIG_KEY_2=core.hooksPath GIT_CONFIG_VALUE_2=/dev/null \
    git commit -qm "main's protected files over the candidate" --allow-empty
) >/dev/null 2>&1 || { echo "verify-trusted: could not lay main's protected files over the candidate"; exit 2; }
. .gate/config.sh || exit 2
gate_prepare "$work/overlay" >/dev/null 2>&1

# 1. Main's checks on the candidate's code.
if ! (cd "$work/overlay" && GATE_BASE="$fork" scripts/verify) >"$work/verify.out" 2>&1; then
  status=1
  echo "verify-trusted: main's verify fails on the candidate's code:"
  tail -n 30 "$work/verify.out" | sed 's/^/  /'
fi
if ! (cd "$work/overlay" && scripts/red-check --base "$fork" ${GATE_BODY_FILE:+--body "$GATE_BODY_FILE"}) >"$work/red.out" 2>&1; then
  status=1
  echo "verify-trusted: main's red-check fails on the candidate's code:"
  tail -n 20 "$work/red.out" | sed 's/^/  /'
fi

# 2. The candidate's own checks against main's fixtures.
if [ -n "$own" ] && ! scripts/prove-check --all --tree "$candidate" >"$work/prove.out" 2>&1; then
  status=1
  echo "verify-trusted: the candidate's checks no longer fail on main's fixtures:"
  sed 's/^/  /' "$work/prove.out"
fi
if [ "$status" -eq 0 ]; then
  echo "verify-trusted: main's verify and red-check pass on the candidate$([ -n "$own" ] && echo ", and its checks fail on main's fixtures")"
  head -1 "$work/red.out" | sed 's/^/  /'
fi
exit "$status"
