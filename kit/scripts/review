#!/usr/bin/env bash
# The jobs of gate-trusted.yml that read the pull request as data: they run in main's checkout, into which the
# candidate's commits were fetched with no work tree, so nothing of the candidate runs and none of its instruction,
# hook, skill or settings files is on disk for a reviewer to load.
#   scripts/review review|verdict|tier --base <sha> --head <sha>
#   scripts/review rounds
#   review   the reviewer's findings, on every pull request; a No-red line in the PR body (GATE_BODY_FILE) needs the
#            reviewer's explicit acceptance
#   verdict  review's verdict from tier 2, read from the review job of its own workflow run (GITHUB_RUN_ID) for this head and
#            base, with no reviewer call of its own; it passes at once on tier 1, so the required check always exists
# The reviewer runs only once `verify` (gate.yml, on pull_request) passed on the head: the cheaper judge first, and a
# red head needs a new commit anyway. The job waits for it up to GATE_WAIT seconds (default 1800, verify's own
# timeout), then fails closed.
#   tier     labels the tier; below tier 3 by paths and labels it waits for `review` of its own workflow run (GITHUB_RUN_ID,
#            up to GATE_REVIEW_WAIT, default 4200 s), so it is never green before the reviewer ended, and follows it: a
#            red or cancelled `review` fails it. It reads the review's result annotation whatever the conclusion; a raise
#            there (or in any review on this head) labels the pull request raised and tier-3, and a result left absent
#            fails it. A raise needs an approval given after it. On tier 3 it requires a code owner who is not the
#            author to have approved the head commit, or a commit whose own patch the head carries unchanged
#            (scripts/lib/approval.mjs); the queue re-runs it after that approval, so the reviewer never runs again for a
#            click
#   rounds   counts the head commits the gate judged red; at three it labels the pull request needs-human (tier 3)
# The tier is main's policy on the diff from the merge-base, raised by every label the pull request ever had (GATE_PR
# and GITHUB_REPOSITORY, read with gh). GATE_HEAD, the pull request's head, must be the head judged.
# GATE_REVIEWER picks the reviewer; it is a repository variable, which only an admin sets:
#   stub    scratch repositories only: scripts/lib/stub-reviewer.mjs, no model
#   claude  scripts/lib/claude-reviewer.mjs: Claude Code, Opus at max effort, read-only tools, in `review` only, once per head:
#           an earlier review of this head, base and No-red line (any run of this workflow) is reused, not asked again
#   unset   fails closed: no reviewer is configured, so nothing merges on this gate
# A reviewer's result counts only through scripts/lib/result.mjs: a missing, malformed or unbound one fails. After it, `review`
# prints the annotation `review-verdict` (head=<sha> base=<sha> pass|block) that `verdict` reads. A reviewer that gave no
# verdict at all (a usage limit, a bad token, a timeout, a result result.mjs refuses, a reviewer that crashed or is not
# configured) leaves `review-result: unavailable: <class>` instead and fails: the check is red, `rounds` does not count the
# head, and `tier` says the reviewer was unavailable. A reviewer output that held a token (exit 4) stays an ordinary red.
set -uo pipefail
trusted=$(git rev-parse --show-toplevel) || exit 2
cd "$trusted" || exit 2
job=${1:-}
[ "$#" -gt 0 ] && shift
base="" head=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --base) base=$2 ;;
    --head) head=$2 ;;
    *) echo "review: unknown argument $1"; exit 2 ;;
  esac
  shift 2
done
case "$job" in review | verdict | tier | rounds) ;; *) echo "usage: scripts/review review|verdict|tier --base <sha> --head <sha>, or scripts/review rounds"; exit 2 ;; esac
# A red round is a head commit on which a required check other than tier failed; tier waits on the Human, not the writer.
if [ "$job" = rounds ]; then
  checks=$(node scripts/lib/policy.mjs checks | grep -vx tier | paste -sd, -) &&
    n=$(node scripts/lib/history.mjs rounds --repo "${GITHUB_REPOSITORY:-}" --pr "${GATE_PR:-}" --checks "$checks") ||
    { echo "rounds: the pull request's rounds could not be read: ${n:-$checks}"; exit 1; }
  echo "rounds: $n head commits judged red"
  [ "$n" -ge 3 ] || exit 0
  gh pr edit "$GATE_PR" --repo "$GITHUB_REPOSITORY" --add-label needs-human >/dev/null || { echo "rounds: could not add the label needs-human"; exit 1; }
  echo "rounds: labelled needs-human after three red rounds; the tier check now waits for the Human's approval"
  exit 0
fi
head=$(git rev-parse --verify --quiet "${head:-none}^{commit}") && fork=$(git merge-base "${base:-none}" "$head" 2>/dev/null) ||
  { echo "$job: the base or the head is not in this checkout; fetch the candidate's commits first"; exit 2; }
if [ -n "${GATE_HEAD:-}" ] && [ "$GATE_HEAD" != "$head" ]; then
  echo "$job: judging $head, but the pull request's head is $GATE_HEAD"
  exit 1
fi

# Prints the tier; returns 1 when it could not be computed, which fails the job closed.
tier_of() {
  local out code
  out=$(scripts/tier --base "$fork" --head "$head" --rules "$trusted" ${GATE_PR:+--pr "$GATE_PR"})
  code=$?
  echo "$out"
  [ "$code" -eq 0 ] || { echo "$job: the tier could not be computed, so this check fails closed"; return 1; }
}

# Waits for the `review` job of this workflow run and reads its result annotation, whatever its conclusion: sets
# $review_red when it ended red or cancelled, and $did_raise and $raised (one line) when it reported a raise. A review
# that ended green and left no result annotation is read again GATE_RESULT_TRIES times (the listing may lag the job), then
# fails closed: absence is never "no raise". Fails closed on a timeout, GATE_REVIEW_WAIT (default 4200 s), which is not
# GATE_WAIT, the wait for verify.
wait_review() {
  local deadline=$((SECONDS + ${GATE_REVIEW_WAIT:-4200})) state tries=0
  raised="" did_raise="" review_red="" unavailable=""
  [ -n "${GITHUB_RUN_ID:-}" ] || { echo "tier: GITHUB_RUN_ID is unset, so the review of this run cannot be found, and this check fails closed"; return 1; }
  while :; do
    state=$(node scripts/lib/history.mjs raise --repo "${GITHUB_REPOSITORY:-}" --run "$GITHUB_RUN_ID" --head "$head") ||
      { echo "tier: the review of run $GITHUB_RUN_ID could not be read ($state), so this check fails closed"; return 1; }
    case "$state" in
      pending)
        [ "$SECONDS" -lt "$deadline" ] || { echo "tier: review did not finish in time, so this check fails closed"; return 1; }
        sleep "${GATE_POLL:-20}"
        continue
        ;;
      "ok none" | "red none") ;;
      "red absent") ;;
      "ok unavailable "* | "red unavailable "*) unavailable=${state#* unavailable } ;;
      "ok absent")
        tries=$((tries + 1))
        [ "$tries" -lt "${GATE_RESULT_TRIES:-6}" ] || { echo "tier: the review ended and left no result annotation after $tries reads, so this check fails closed"; return 1; }
        sleep "${GATE_RESULT_POLL:-10}"
        continue
        ;;
      "ok raise "* | "red raise "*) did_raise=1; raised=${state#* raise }; [ -n "$raised" ] || raised="(no reason given)" ;;
      *) echo "tier: the review of run $GITHUB_RUN_ID gave an answer this check does not know, so it fails closed"; return 1 ;;
    esac
    [ "${state%% *}" = red ] && review_red=1
    return 0
  done
}

# Waits for the `review` job of this workflow run and passes only with a review that passed for this head and base: its
# review-verdict annotation names both. A result for another head or base, a blocking or absent one, or a review that
# ended without one fails closed. Prints the unavailable notice first when review had no verdict.
wait_verdict() {
  local deadline=$((SECONDS + ${GATE_REVIEW_WAIT:-4200})) state tries=0
  [ -n "${GITHUB_RUN_ID:-}" ] || { echo "verdict: GITHUB_RUN_ID is unset, so the review of this run cannot be found, and this check fails closed"; return 1; }
  while :; do
    state=$(node scripts/lib/history.mjs verdict --repo "${GITHUB_REPOSITORY:-}" --run "$GITHUB_RUN_ID" --head "$head" --base "$fork") ||
      { echo "verdict: the review of run $GITHUB_RUN_ID could not be read ($state), so this check fails closed"; return 1; }
    case "$state" in
      pending)
        [ "$SECONDS" -lt "$deadline" ] || { echo "verdict: review did not finish in time, so this check fails closed"; return 1; }
        sleep "${GATE_POLL:-20}"
        ;;
      "ok pass") echo "verdict: review passed ${head:0:8}"; return 0 ;;
      "ok block" | "red block") echo "verdict: review blocks ${head:0:8}"; return 1 ;;
      "ok mismatch" | "red mismatch") echo "verdict: the review's verdict names another head or base than ${head:0:8}, so this check fails closed"; return 1 ;;
      "red absent") echo "verdict: review ended without a result (verify red, or the reviewer failed before it), so this check fails closed"; return 1 ;;
      "ok absent")
        tries=$((tries + 1))
        [ "$tries" -lt "${GATE_RESULT_TRIES:-6}" ] || { echo "verdict: the review ended and left no verdict annotation after $tries reads, so this check fails closed"; return 1; }
        sleep "${GATE_RESULT_POLL:-10}"
        ;;
      "ok unavailable "* | "red unavailable "*)
        echo "::notice title=review-result::unavailable: ${state#* unavailable }"
        echo "verdict: reviewer unavailable (${state#* unavailable }); this is not a finding on the change, so this check fails closed"
        return 1
        ;;
      *) echo "verdict: the review of run $GITHUB_RUN_ID gave an answer this check does not know ($state), so it fails closed"; return 1 ;;
    esac
  done
}

case "$job" in
  tier)
    out=$(tier_of) || { echo "$out"; exit 1; }
    n=$(echo "$out" | sed -n '1s/^tier \([123]\)$/\1/p')
    # Paths and labels already giving tier 3, a raise adds nothing: the wait is for the other tiers only. Every line that
    # prints the reviewer's reason starts with a fixed prefix and holds it on one line with `##[` broken.
    if [ "$n" != 3 ] && [ -n "${GATE_PR:-}" ]; then
      wait_review || exit 1
      if [ -n "$unavailable" ]; then
        echo "$out"
        echo "tier: reviewer unavailable ($unavailable); this is not a finding on the change, so this check fails closed. Re-run the failed jobs when the reviewer is back"
        exit 1
      fi
      if [ -n "$did_raise" ]; then
        # Adding a label a pull request already has makes no event, and the approval must follow this one's: remove first.
        if ! gh pr edit "$GATE_PR" --repo "$GITHUB_REPOSITORY" --remove-label raised >/dev/null 2>&1; then
          # A failed remove is fine when raised is not there. When another account's raised is, tier would add nothing new
          # and leave no event of its own, so it fails closed.
          have=$(node scripts/lib/history.mjs labels --repo "${GITHUB_REPOSITORY:-}" --pr "$GATE_PR") ||
            { echo "tier: the label raised could not be removed, and the labels could not be read ($have), so this check fails closed"; exit 1; }
          case ",$have," in *,raised,*) echo "tier: the label raised is on the pull request and could not be removed, so tier cannot make its own event for the raise, and this check fails closed"; exit 1 ;; esac
        fi
        gh pr edit "$GATE_PR" --repo "$GITHUB_REPOSITORY" --add-label raised --add-label tier-3 >/dev/null ||
          { echo "tier: the reviewer raised this change, and the labels raised and tier-3 could not be added; if raised does not exist, create it: gh label create raised --repo ${GITHUB_REPOSITORY:-}"; exit 1; }
      fi
      # The labels are read again: a label added during the wait counts.
      out=$(tier_of) || { echo "$out"; exit 1; }
      n=$(echo "$out" | sed -n '1s/^tier \([123]\)$/\1/p')
      if [ -n "$did_raise" ]; then
        out="tier 3
  raised by the reviewer: $raised"
        n=3
      fi
      if [ -n "$review_red" ]; then
        echo "$out"
        echo "tier: review is red; tier follows it, so this check fails"
        exit 1
      fi
    fi
    echo "$out"
    if [ -n "${GATE_PR:-}" ]; then
      gh pr edit "$GATE_PR" --repo "$GITHUB_REPOSITORY" --add-label "tier-$n" >/dev/null || echo "tier: could not add the label tier-$n, which only shows the tier"
      for k in 1 2 3; do
        [ "$k" -lt "$n" ] && gh pr edit "$GATE_PR" --repo "$GITHUB_REPOSITORY" --remove-label "tier-$k" >/dev/null 2>&1
      done
    fi
    [ "$n" = 3 ] || exit 0
    reviews=$(gh api --paginate --slurp "repos/${GITHUB_REPOSITORY:-}/pulls/${GATE_PR:-}/reviews") || { echo "tier: tier 3 needs the Human's approval, and the reviews could not be read"; exit 1; }
    # A raised pull request needs an approval given after the raise: the Human reads the reason, not an earlier head.
    after=""
    if [ -n "${GATE_PR:-}" ]; then
      after=$(node scripts/lib/history.mjs raised-at --repo "${GITHUB_REPOSITORY:-}" --pr "$GATE_PR") || { echo "tier: when the pull request was raised could not be read ($after), so this check fails closed"; exit 1; }
      [ -n "$after" ] || [ -z "${did_raise:-}" ] || after=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    fi
    printf '%s' "$reviews" | node scripts/lib/approval.mjs --owners .github/CODEOWNERS --author "${GATE_PR_AUTHOR:-}" --head "$head" --base "$base" ${after:+--after "$after"} || exit 1
    exit 0
    ;;
  verdict)
    out=$(tier_of) || { echo "$out"; exit 1; }
    case "$out" in "tier 1"*) echo "$out"; echo "verdict: tier 1: not required"; exit 0 ;; esac
    # From tier 2 it takes review's result: the one reviewer call of this pull request was review's.
    msg=$(wait_verdict)
    code=$?
    case "$msg" in
      "::notice"*) printf '%s\n' "$msg"; echo "$out" ;; # the unavailable notice comes first
      *) echo "$out"; printf '%s\n' "$msg" ;;
    esac
    exit "$code"
    ;;
esac

# Waits for gate.yml's verify on the head; returns 1 unless it passed.
wait_verify() {
  local deadline=$((SECONDS + ${GATE_WAIT:-1800})) state
  while :; do
    state=$(node scripts/lib/history.mjs check --repo "${GITHUB_REPOSITORY:-}" --head "$head" --name verify) ||
      { echo "$job: verify on ${head:0:8} could not be read ($state), so this check fails closed"; return 1; }
    case "$state" in
      success) return 0 ;;
      pending)
        [ "$SECONDS" -lt "$deadline" ] || { echo "$job: verify did not finish on ${head:0:8} in time, so this check fails closed"; return 1; }
        sleep "${GATE_POLL:-20}"
        ;;
      *) echo "$job: verify is $state on ${head:0:8}, so the reviewer does not run; a new commit is judged afresh"; return 1 ;;
    esac
  done
}
wait_verify || exit 1

claim=""
if [ "$job" = review ] && [ -n "${GATE_BODY_FILE:-}" ] && grep -Eq '^No-red: .{20,}' "$GATE_BODY_FILE"; then claim=--no-red; fi
result=$(mktemp) || exit 2
trap 'rm -f "$result"' EXIT
notes=$(mktemp) || exit 2
trap 'rm -f "$result" "$notes"' EXIT
# The No-red line the review judged, by hash: an edit that changes it is a new question for the reviewer.
nored=none
if [ -n "${GATE_BODY_FILE:-}" ] && line=$(grep -E -m1 '^No-red: .{20,}' "$GATE_BODY_FILE"); then
  nored=$(printf '%s' "$line" | node -e 'process.stdout.write(require("crypto").createHash("sha256").update(require("fs").readFileSync(0)).digest("hex").slice(0, 16))')
fi
if [ "$job" = review ] && [ "${GATE_REVIEWER:-}" = claude ] && [ -n "${GITHUB_RUN_ID:-}" ]; then
  if prior=$(node scripts/lib/history.mjs reuse --repo "${GITHUB_REPOSITORY:-}" --run "$GITHUB_RUN_ID" --head "$head" --base "$fork" --nored "$nored" 2>&1); then
    case "$prior" in
      "reuse "*)
        read -r _ pv rid rest <<<"$prior"
        if [ "$rest" = none ]; then echo "::notice title=review-result::none"; else why=${rest#raise }; echo "::notice title=review-result::raise: ${why//%/%25}"; fi
        echo "review: reused the review of run $rid for this head, base and No-red line; no call made (one call per head)"
        echo "::notice title=review-verdict::head=$head base=$fork nored=$nored $pv"
        [ "$pv" = pass ] && exit 0
        echo "review blocks ${head:0:8} (reused; its findings are in the log of run $rid)"
        exit 1
        ;;
    esac
  else
    echo "$job: earlier reviews of this head could not be read ($prior), so the reviewer is asked again"
  fi
fi
case "${GATE_REVIEWER:-}" in
  stub) node scripts/lib/stub-reviewer.mjs "$job" "$fork" "$head" >"$result" ;;
  claude)
    node scripts/lib/claude-reviewer.mjs "$job" "$fork" "$head" --out "$result" >"$notes"
    code=$?
    if [ "$code" -ne 0 ]; then
      if [ "$code" -ne 3 ] && [ "$code" -ne 4 ]; then
        echo "::notice title=review-result::unavailable: crash"
        echo "$job: the Claude reviewer failed (exit $code); this is not a finding on the change, so this check fails closed"
      fi
      cat "$notes"
      exit 1
    fi
    ;;
  "")
    echo "::notice title=review-result::unavailable: no-reviewer"
    echo "$job: no reviewer is configured (repository variable GATE_REVIEWER is unset), so this check fails closed"
    exit 1
    ;;
  *)
    echo "::notice title=review-result::unavailable: no-reviewer"
    echo "$job: unknown reviewer '$GATE_REVIEWER' (known: stub, claude), so this check fails closed"
    exit 1
    ;;
esac
checked=$(node scripts/lib/result.mjs --job "$job" --base "$fork" --head "$head" $claim <"$result")
code=$?
# A result result.mjs refuses says nothing about the change: unavailable, not a red round.
[ "$code" -eq 2 ] && echo "::notice title=review-result::unavailable: malformed"
printf '%s\n' "$checked"
# review's verdict for verdict to read: fixed text, the SHAs it judged, the No-red line (by hash) and whether it blocks.
[ "$code" -le 1 ] && echo "::notice title=review-verdict::head=$head base=$fork nored=$nored $([ "$code" -eq 0 ] && echo pass || echo block)"
cat "$notes"
[ "$code" -eq 0 ] || exit 1
