#!/usr/bin/env bash
# Makes this clone use the repository's hooks; safe to run again. Git runs them for any agent, a shell or the Human.
#   scripts/setup        point core.hooksPath at .githooks
#   scripts/setup --ci   also make the checkout ready to test (gate_prepare in .gate/config.sh)
set -uo pipefail
top=$(git rev-parse --show-toplevel) || exit 2
cd "$top" || exit 2
git config core.hooksPath .githooks || exit 1
chmod +x .githooks/* scripts/verify scripts/verify-trusted scripts/setup scripts/rules scripts/tier scripts/red-check scripts/prove-check scripts/review 2>/dev/null
if [ "${1:-}" = --ci ]; then
  . .gate/config.sh || exit 2
  gate_prepare "$top" || { echo "setup: gate_prepare failed"; exit 1; }
fi
echo "setup: hooks from .githooks"
