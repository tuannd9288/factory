#!/usr/bin/env bash
# Shows that a check can fail: commits its fixture in a throwaway work tree and requires the check to fail there,
# saying what the fixture names. A check without a fixture fails, so a check nobody proved cannot pass verify.
#   scripts/prove-check <check>        the fixture .gate/proofs/<check>.patch (or .sh, a script that makes commits)
#   scripts/prove-check --all          every check verify runs, plus red-check and tier
#   --tree <dir>    prove the scripts of another checkout with this checkout's fixtures (verify-trusted does)
# A fixture's header, before its first "diff --git" (in a .sh fixture, as comments), may set "Run: <command>" (default:
# scripts/verify --only <check>) and "Says: <regex>" that the failing output must match (default: the check's name).
set -uo pipefail
top=$(git rev-parse --show-toplevel) || exit 2
cd "$top" || exit 2
. .gate/config.sh || { echo "prove-check: could not read .gate/config.sh"; exit 2; }

tree=$top
all=0
names=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --tree) tree=$(cd "$2" && pwd) || exit 2; shift 2 ;;
    --all) all=1; shift ;;
    *) names="$names $1"; shift ;;
  esac
done
[ "$all" -eq 1 ] && names="instructions policy rules tests $GATE_CHECKS red-check tier"
[ -n "$names" ] || { echo "prove-check: name a check, or --all"; exit 2; }

# The fixture's commits name a throwaway author and run no hooks; the repository's own config is not touched.
export GIT_CONFIG_COUNT=3 GIT_CONFIG_KEY_0=user.name GIT_CONFIG_VALUE_0=gate GIT_CONFIG_KEY_1=user.email \
  GIT_CONFIG_VALUE_1=gate@localhost GIT_CONFIG_KEY_2=core.hooksPath GIT_CONFIG_VALUE_2=/dev/null
work=$(mktemp -d) || exit 2
trap 'git -C "$tree" worktree prune >/dev/null 2>&1; rm -rf "$work"' EXIT
# The tree's tracked edits are part of what is proved; untracked files are not.
snapshot=$(git -C "$tree" stash create 2>/dev/null)
snapshot=${snapshot:-$(git -C "$tree" rev-parse HEAD)} || exit 2

proved=0
broken=""
for name in $names; do
  fixture=""
  for f in "$top/.gate/proofs/$name.patch" "$top/.gate/proofs/$name.sh"; do [ -f "$f" ] && fixture=$f && break; done
  if [ -z "$fixture" ]; then
    echo "prove-check: $name has no fixture in .gate/proofs/; a check is not counted until it is shown failing"
    broken="$broken $name"
    continue
  fi
  run=$(sed -n '/^diff --git/q;s/^\(# \)\{0,1\}Run: //p' "$fixture" | head -1)
  says=$(sed -n '/^diff --git/q;s/^\(# \)\{0,1\}Says: //p' "$fixture" | head -1)
  run=${run:-scripts/verify --only $name}
  says=${says:-$name}
  w="$work/$name"
  if ! git -C "$tree" worktree add --detach --quiet "$w" "$snapshot" 2>"$work/$name.err"; then
    echo "prove-check: $name: could not make a work tree: $(head -1 "$work/$name.err")"
    broken="$broken $name"
    continue
  fi
  (
    cd "$w" || exit 2
    case "$fixture" in
      *.patch) git apply --whitespace=nowarn "$fixture" && git add -A && git commit -qm "gate proof: $name" ;;
      *.sh) bash "$fixture" ;;
    esac
  ) >"$work/$name.setup" 2>&1
  if [ $? -ne 0 ]; then
    echo "prove-check: $name: the fixture did not apply:"
    tail -n 5 "$work/$name.setup" | sed 's/^/  /'
    broken="$broken $name"
    git -C "$tree" worktree remove --force "$w" >/dev/null 2>&1
    continue
  fi
  gate_prepare "$w" >/dev/null 2>&1
  (cd "$w" && GATE_BASE=HEAD~1 GATE_REPORT="$work/$name.xml" bash -c "$run") >"$work/$name.out" 2>&1
  code=$?
  if [ "$code" -eq 0 ]; then
    echo "prove-check: $name PASSED its fixture, so it would not catch what the fixture breaks ($run)"
    broken="$broken $name"
  elif ! grep -Eq -- "$says" "$work/$name.out"; then
    echo "prove-check: $name failed its fixture for another reason; expected output matching /$says/:"
    tail -n 8 "$work/$name.out" | sed 's/^/  /'
    broken="$broken $name"
  else
    proved=$((proved + 1))
  fi
  git -C "$tree" worktree remove --force "$w" >/dev/null 2>&1
done

if [ -n "$broken" ]; then
  echo "prove-check: not proved:$broken"
  exit 1
fi
echo "prove-check: $proved checks fail on their fixtures"
