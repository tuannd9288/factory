#!/usr/bin/env bash
# Requires the change's new or changed tests to fail at the base and pass at the head, judged on JUnit reports:
# at the base tests > 0, failures > 0 and errors == 0 (a test that cannot load there proves nothing); at the head
# every one passes. Passes without a source change, or on a "No-red: <reason of 20 or more characters>" line in the
# PR body, which the reviewer must accept for `review` to pass; the ledger counts it. First, for each proof the change
# adds for a dropped test (scripts/lib/proofs.mjs), it makes the proof's break in a copy of the head and requires the
# kept test green without it and red under it, as a test: a change that only drops a test has no source change.
#   scripts/red-check [--base <rev>] [--body <file>]
set -uo pipefail
top=$(git rev-parse --show-toplevel) || exit 2
cd "$top" || exit 2
. .gate/config.sh || { echo "red-check: could not read .gate/config.sh"; exit 2; }

base="" body=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --base) base=$2 ;;
    --body) body=$2 ;;
    *) echo "red-check: unknown argument $1"; exit 2 ;;
  esac
  shift 2
done
[ -n "$base" ] || base=$(git merge-base HEAD origin/main 2>/dev/null) || { echo "red-check: no merge-base with origin/main; pass --base"; exit 2; }
base=$(git rev-parse --verify "$base^{commit}") || { echo "red-check: $base is not a commit"; exit 2; }

work=$(mktemp -d) || exit 2
cleanup() {
  git worktree remove --force "$work/base" >/dev/null 2>&1
  git worktree remove --force "$work/head" >/dev/null 2>&1
  rm -rf "$work"
}
trap cleanup EXIT
count() { printf '%s\n' "$1" | head -1 | tr ' ' '\n' | sed -n "s/^$2=//p"; }

proofs=$(node scripts/lib/proofs.mjs list "$base") || { echo "red-check: the proofs for dropped tests could not be read: $proofs"; exit 2; }
if [ -n "$proofs" ]; then
  git worktree add --detach --quiet "$work/head" HEAD || { echo "red-check: could not check out the head"; exit 2; }
  (cd "$work/head" && gate_prepare "$work/head" >/dev/null 2>&1)
  dropped=0
  # fd 3: a test runner reading stdin would eat the list.
  while IFS=$'\t' read -r -u 3 n path kept name said; do
    git -C "$work/head" checkout --quiet -- .
    (cd "$work/head" && GATE_REPORT="$work/green.xml" gate_tests "$kept" >/dev/null 2>&1)
    green=$(node scripts/lib/junit.mjs --failures "$work/green.xml")
    if [ "$(count "$green" tests)" -eq 0 ] || [ "$(count "$green" failures)" -gt 0 ] || [ "$(count "$green" errors)" -gt 0 ]; then
      echo "red-check: $path dropped: $kept does not pass at the head ($(printf '%s\n' "$green" | head -1))"
      dropped=1
      continue
    fi
    if ! broke=$(node scripts/lib/proofs.mjs break "$base" "$n" "$work/head"); then
      echo "red-check: $path dropped: the break cannot be made: $broke"
      dropped=1
      continue
    fi
    (cd "$work/head" && GATE_REPORT="$work/red.xml" gate_tests "$kept" >/dev/null 2>&1)
    red=$(node scripts/lib/junit.mjs --failures "$work/red.xml")
    rt=$(count "$red" tests) rf=$(count "$red" failures) re=$(count "$red" errors)
    if [ "$re" -gt 0 ]; then
      echo "red-check: ${said/ is red under / cannot run under } ($(printf '%s\n' "$red" | head -1)); an error is not a red"
      dropped=1
    elif [ "$rf" -eq 0 ]; then
      echo "red-check: ${said/ is red under / stays green under }, so it does not show the code it guards"
      dropped=1
    elif ! printf '%s\n' "$red" | grep -F '  failed: ' | grep -qF -- "$name"; then
      echo "red-check: ${said/ is red under / is not among the tests red under }:"
      printf '%s\n' "$red" | tail -n +2
      dropped=1
    else
      echo "red-check: $said ($rf of $rt failed), green without it"
    fi
  done 3<<<"$proofs"
  git worktree remove --force "$work/head" >/dev/null 2>&1
  [ "$dropped" -eq 0 ] || exit 1
fi

# A deleted source file is a source change; a test is one the head still holds.
kinds() { git -c core.quotePath=false diff --name-only --no-renames --diff-filter="$1" "$base" HEAD | node scripts/lib/paths.mjs; }
tests=$(kinds AM) && sources=$(kinds AMD) || { echo "red-check: could not sort the changed paths"; exit 2; }
tests=$(printf '%s\n' "$tests" | sed -n 's/^test	//p')
sources=$(printf '%s\n' "$sources" | sed -n 's/^source	//p')

if [ -z "$sources" ]; then
  echo "red-check: no source change"
  exit 0
fi
reason=$( [ -n "$body" ] && [ -f "$body" ] && grep -E '^No-red: .{20,}' "$body" | head -1 )
if [ -n "$reason" ]; then
  echo "red-check: passed by the PR body's $reason"
  exit 0
fi
if [ -z "$tests" ]; then
  # A module (modules/<name>/, laid only where .gate/modules names it) may prove a change with no test: its script, where it
  # exists, goes first. Without it nothing here runs, and the verdicts are main's.
  proof="" code=1
  if [ -f scripts/lib/deletion.mjs ]; then
    printf '%s\n' "$sources" >"$work/sources"
    proof=$(node scripts/lib/deletion.mjs prove --base "$base" --sources "$work/sources" --work "$work"); code=$?
    [ "$code" -eq 0 ] && { printf '%s\n' "$proof"; exit 0; }
  fi
  echo "red-check: source changed with no new or changed test:"
  printf '%s\n' "$sources" | sed 's/^/  /'
  [ -z "$proof" ] || printf '%s\n' "$proof"
  [ "$code" -eq 2 ] && exit 2
  echo "Add a test that fails without the change, or give the PR body a line 'No-red: <why no test can fail first>'."
  exit 1
fi

git worktree add --detach --quiet "$work/base" "$base" || { echo "red-check: could not check out the base $base"; exit 2; }
printf '%s\n' "$tests" | while IFS= read -r t; do
  mkdir -p "$work/base/$(dirname "$t")" && git show "HEAD:$t" >"$work/base/$t"
done
# The tests are file arguments; their paths come from git and hold no newline.
# shellcheck disable=SC2086
set -f
(cd "$work/base" && gate_prepare "$work/base" >/dev/null 2>&1 && GATE_REPORT="$work/base.xml" gate_tests $tests >/dev/null 2>&1)
at_base=$(node scripts/lib/junit.mjs --failures "$work/base.xml")
GATE_REPORT="$work/head.xml" gate_tests $tests >/dev/null 2>&1
head_code=$?
set +f
at_head=$(node scripts/lib/junit.mjs --failures "$work/head.xml")

bt=$(count "$at_base" tests) bf=$(count "$at_base" failures) be=$(count "$at_base" errors)
ht=$(count "$at_head" tests) hf=$(count "$at_head" failures) he=$(count "$at_head" errors)

if [ "$be" -gt 0 ]; then
  echo "red-check: at the base the tests could not run ($(printf '%s\n' "$at_base" | head -1)); an error is not a red:"
  printf '%s\n' "$at_base" | tail -n +2
  echo "Make the test fail as a test at the base: import the module, not a name it lacks (import * as m), or load a new file inside the test with await import()."
  exit 1
fi
if [ "$bt" -eq 0 ]; then
  echo "red-check: the new or changed tests select no test at the base"
  exit 1
fi
if [ "$bf" -eq 0 ]; then
  echo "red-check: the new or changed tests pass at the base $( git rev-parse --short "$base"), so they do not show the change ($(printf '%s\n' "$at_base" | head -1)):"
  printf '%s\n' "$tests" | sed 's/^/  /'
  exit 1
fi
if [ "$head_code" -ne 0 ] || [ "$ht" -eq 0 ] || [ "$hf" -gt 0 ] || [ "$he" -gt 0 ]; then
  echo "red-check: at the head the tests do not pass ($(printf '%s\n' "$at_head" | head -1)):"
  printf '%s\n' "$at_head" | tail -n +2
  exit 1
fi
echo "red-check: red at the base ($bf of $bt failed), green at the head ($ht passed)"
