#!/usr/bin/env bash
# The tier job of gate-trusted.yml, which reads the pull request as data: it runs in main's checkout, into which the
# candidate's commits were fetched with no work tree, so nothing of the candidate runs. No reviewer runs on Actions (FAC-100).
#   .gate/bin/review tier --base <sha> --head <sha>
#   tier     labels the tier and waits for nothing (FAC-100): the paths and every label the pull request ever had. Text drawn
#            from the pull request is printed between ::stop-commands:: markers with a random token. On tier 3
#            it requires a code owner who is not the author to have approved the head commit, or a commit whose own patch the head carries unchanged
#            (.gate/bin/lib/approval.mjs); the queue re-runs it after that approval. Before that it reads the repository's merge switch (#333, .gate/bin/lib/switch.mjs) from the rules in
#            force on the base branch and records the position on its own check run (the annotation "merge switch"): on
#            tier 3, at `all` the approval is not asked, at `1-2` and `none` it is, and rules it cannot read as a position
#            fail it; below tier 3 nothing is read. The claim, the labels and the other checks are asked at every position;
#            the queue re-runs a tier 3 check whose recorded position and the one in force differ in a way that changes
#            its verdict
#            While it waits for the approval (approval.mjs exits 1) it requests the review of the code owners of
#            .github/CODEOWNERS other than the author, users only, with one POST to the pull request's requested_reviewers
#            for each owner (#374): the pull request is in their review queue. It requests nothing below tier 3, at the
#            switch's `all` or once approved, and a failed request prints one line and leaves the result as it was
#            Once the tier is final it also writes it for Linear's Reviews (#379): post_risk below, one comment of the pull
#            request that holds a `linear:extension` riskScore block for the head, at every tier and every switch position;
#            a failed write prints one line and leaves the result as it was
# The tier is main's policy on the diff from the merge-base, raised by every label the pull request ever had (GATE_PR
# and GITHUB_REPOSITORY, read with gh). GATE_HEAD, the pull request's head, must be the head judged.
set -uo pipefail
trusted=$(git rev-parse --show-toplevel) || exit 2
cd "$trusted" || exit 2
job=${1:-}
[ "$#" -gt 0 ] && shift
base="" head=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --base) base=$2 ;;
    --head) head=$2 ;;
    *) echo "review: unknown argument $1"; exit 2 ;;
  esac
  shift 2
done
case "$job" in tier) ;; *) echo "usage: .gate/bin/review tier --base <sha> --head <sha>"; exit 2 ;; esac
# Requests the review of the code owners of .github/CODEOWNERS (main's) other than the author, so the pull request is in their
# review queue while it waits for their approval (#374). Users only: a team owner is named, not requested. One POST for each
# owner, since GitHub refuses a whole request (422) when one of its users is not a collaborator. A failed request prints one
# line and changes nothing: the caller's result stands.
request_owners() {
  local list kind who draft done_=() failed=()
  draft=$(gh pr view "${GATE_PR:-}" --repo "${GITHUB_REPOSITORY:-}" --json isDraft --jq .isDraft) ||
    { echo "$job: could not read draft status; no code-owner review requested"; return 0; }
  [ "$draft" = false ] || return 0
  list=$(node .gate/bin/lib/approval.mjs --owners .github/CODEOWNERS --author "${GATE_PR_AUTHOR:-}" --list) ||
    { echo "$job: could not request the review of the code owners: .github/CODEOWNERS could not be read"; return 0; }
  while read -r kind who; do
    case "$kind" in
      user)
        if gh api -X POST "repos/${GITHUB_REPOSITORY:-}/pulls/${GATE_PR:-}/requested_reviewers" -f "reviewers[]=$who" >/dev/null 2>&1; then
          done_+=("$who")
        else
          failed+=("$who")
        fi
        ;;
      team) echo "$job: the code owner $who is a team, which is not requested" ;;
    esac
  done <<<"$list"
  [ "${#done_[@]}" -eq 0 ] || echo "$job: requested the review of ${done_[*]}"
  [ "${#failed[@]}" -eq 0 ] || echo "$job: could not request the review of ${failed[*]}"
  return 0
}
# Writes the tier as the gate judged it into Linear's Reviews (#379): one comment of the pull request, found by its marker among
# the comments the job's own login wrote (github-actions[bot], the login of the job's token; GATE_BOT_LOGIN overrides) and edited,
# or created when there is none, and left alone when it already holds the body the run would write. The comment holds a `linear:extension` block with the riskScore plugin for $head: level 1, 2 or 3
# for tier 1, 2 or 3 (Linear's level 4 is not used, the gate has no fourth tier), and the reasons tier printed, cut to Linear's
# limits (.gate/bin/lib/risk-score.mjs). It records the tier, for every tier and at every position of the merge switch, and asks
# nothing of anyone. No Linear key and no Linear call. A failed read or write prints one line and changes nothing: the caller's
# result stands. Takes the tier command's output and the tier number.
post_risk() {
  local text="$1" level="$2" comment list found id same
  comment=$(printf '%s\n' "$text" | node .gate/bin/lib/risk-score.mjs body --sha "$head" --tier "$level") ||
    { echo "$job: could not write the risk score for Linear's Reviews: the comment could not be built${comment:+ ($comment)}"; return 0; }
  list=$(gh api --paginate --slurp "repos/${GITHUB_REPOSITORY:-}/issues/${GATE_PR:-}/comments?per_page=100") ||
    { echo "$job: could not write the risk score for Linear's Reviews: the comments could not be read"; return 0; }
  found=$(printf '%s' "$list" | node .gate/bin/lib/risk-score.mjs find --login "${GATE_BOT_LOGIN:-github-actions[bot]}" --body "$comment") ||
    { echo "$job: could not write the risk score for Linear's Reviews: the comments could not be read as comments"; return 0; }
  read -r id same <<<"$found"
  if [ "$same" = same ]; then
    echo "$job: the risk score comment for Linear's Reviews already holds tier $level at ${head:0:8}; nothing written"
    return 0
  elif [ -n "$id" ]; then
    gh api -X PATCH "repos/${GITHUB_REPOSITORY:-}/issues/comments/$id" -f "body=$comment" >/dev/null 2>&1 ||
      { echo "$job: could not edit the risk score comment for Linear's Reviews"; return 0; }
  else
    gh api -X POST "repos/${GITHUB_REPOSITORY:-}/issues/${GATE_PR:-}/comments" -f "body=$comment" >/dev/null 2>&1 ||
      { echo "$job: could not write the risk score comment for Linear's Reviews"; return 0; }
  fi
  echo "$job: wrote the risk score for Linear's Reviews (tier $level at ${head:0:8})"
  return 0
}
head=$(git rev-parse --verify --quiet "${head:-none}^{commit}") && fork=$(git merge-base "${base:-none}" "$head" 2>/dev/null) ||
  { echo "$job: the base or the head is not in this checkout; fetch the candidate's commits first"; exit 2; }
if [ -n "${GATE_HEAD:-}" ] && [ "$GATE_HEAD" != "$head" ]; then
  echo "$job: judging $head, but the pull request's head is $GATE_HEAD"
  exit 1
fi

# Prints the tier; returns 1 when it could not be computed, which fails the job closed.
tier_of() {
  local out code
  out=$(.gate/bin/tier --base "$fork" --head "$head" --rules "$trusted" ${GATE_PR:+--pr "$GATE_PR"})
  code=$?
  # The reasons hold changed paths, which a pull request names: none may read as a workflow command in the log, even after
  # white space (the runner trims it), as a legacy `##[` command or as an escaped line break at the start of a line.
  echo "$out" | sed -e 's/^\([[:space:]]*\)::/\1: :/' -e 's/^\([[:space:]]*\)%0[aA]/\1% 0A/' -e 's/##\[/## [/g'
  [ "$code" -eq 0 ] || { echo "$job: the tier could not be computed, so this check fails closed"; return 1; }
}

# Prints text drawn from the pull request (changed paths, the claim's team) between ::stop-commands::<token> and ::<token>::,
# the token fresh random text made here, so no line of it is read as a workflow command whatever characters precede it, and
# tier's own notice, printed after the closing line, is never swallowed. Fails closed when no token can be made.
guarded() {
  local token
  token=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
  [ "${#token}" -ge 16 ] || { echo "$job: no random token could be made to hold the pull request's text, so this check fails closed"; exit 1; }
  printf '::stop-commands::%s\n%s\n::%s::\n' "$token" "$1" "$token"
}

# The pull request's Issue: and Claim: lines against the tip of claim/<n> on origin, read now (claim.mjs check). Red prints
# why; green keeps the line in $claim_msg, which tier prints with the tier. Only with a pull request (GATE_PR).
claim_check() {
  local msg code
  claim_msg=""
  [ -n "${GATE_PR:-}" ] || return 0
  msg=$(node .gate/bin/lib/claim.mjs check --repo "${GITHUB_REPOSITORY:-}" --pr "$GATE_PR")
  code=$?
  [ "$code" -eq 0 ] || { guarded "$msg"; echo "tier: the claim check is red, so this check fails"; return 1; }
  claim_msg=$msg
}

case "$job" in
  tier)
    out=$(tier_of) || { guarded "$out"; exit 1; }
    n=$(echo "$out" | sed -n '1s/^tier \([123]\)$/\1/p')
    claim_check || exit 1
    guarded "$out"
    [ -z "$claim_msg" ] || guarded "$claim_msg"
    if [ -n "${GATE_PR:-}" ]; then
      post_risk "$out" "$n"
      gh pr edit "$GATE_PR" --repo "$GITHUB_REPOSITORY" --add-label "tier-$n" >/dev/null || echo "tier: could not add the label tier-$n, which only shows the tier"
      for k in 1 2 3; do
        [ "$k" -lt "$n" ] && gh pr edit "$GATE_PR" --repo "$GITHUB_REPOSITORY" --remove-label "tier-$k" >/dev/null 2>&1
      done
    fi
    [ "$n" = 3 ] || exit 0
    # The merge switch (#333), read from the rules in force on the base branch (GATE_BASE_REF): at all, the Human's approval of
    # tier 3 is not asked; at 1-2 and none it is, as before. Rules that cannot be read as a position fail closed. The position
    # read is recorded on this job's own check run, as the annotation "merge switch", which only this job can write: the queue
    # compares it with the position in force and re-runs a tier 3 check that ran at another. No record is written when the
    # rules cannot be read.
    position=$(gh api --paginate --slurp "repos/${GITHUB_REPOSITORY:-}/rules/branches/${GATE_BASE_REF:-main}" 2>&1 | node .gate/bin/lib/switch.mjs) ||
      { echo "tier: the merge switch could not be read ($position), so this check fails closed"; exit 1; }
    echo "::notice title=merge switch::$position"
    if [ "$position" = all ]; then
      echo "tier: the merge switch of this repository is at all, so the Human's approval of tier 3 is not asked"
      exit 0
    fi
    reviews=$(gh api --paginate --slurp "repos/${GITHUB_REPOSITORY:-}/pulls/${GATE_PR:-}/reviews") || { echo "tier: tier 3 needs the Human's approval, and the reviews could not be read"; exit 1; }
    # An approval given before the base last changed showed the diff from the old base: it counts only through the old base's merged
    # pull request (FAC-41: a stack's child moved onto main before its parent landed carries the parent's change).
    moved=""
    if [ -n "${GATE_PR:-}" ]; then
      moved=$(node .gate/bin/lib/history.mjs moved --repo "${GITHUB_REPOSITORY:-}" --pr "$GATE_PR") || { echo "tier: the base changes of the pull request could not be read ($moved), so this check fails closed"; exit 1; }
    fi
    printf '%s' "$reviews" | node .gate/bin/lib/approval.mjs --owners .github/CODEOWNERS --author "${GATE_PR_AUTHOR:-}" --head "$head" --base "$base" ${moved:+--moved-at "${moved%% *}" --parent-head "${moved#* }"}
    code=$?
    # Waiting for his approval (exit 1): request his review, then fail as before.
    [ "$code" -ne 0 ] || exit 0
    [ "$code" -ne 1 ] || request_owners
    exit 1
    ;;
esac
