#!/usr/bin/env bash
# packs/pstack/bin/lead <repo> [--new] [--dry-run] (#163, #166): starts the pstack Lead of one onboarded repository, an interactive
# claude session in ~/WORKSPACES/<repo> on the repository's own profile. `factory lead <repo>` runs it. It resumes the newest
# earlier session (from the transcript copies, never from the profile) unless --new. It runs the repository's .gate/bin/setup,
# installs the plugins the repository's own .claude/settings.json enables (never adds a pin) and execs `direnv exec . claude`.
# Nobody logs in (#179): it needs the row factory/lead-<repo> in the accounts file and, with none, exits 2 naming `factory use
# lead-<repo> <letter>`; it gives the row's token to claude's environment alone. --dry-run prints the folder, the plugin plan, the
# command, the session choice and an `account:` line, and runs nothing. Exits 2 on a refusal. See lead.mjs.
exec node "$(dirname "$0")/lead.mjs" "$@"
