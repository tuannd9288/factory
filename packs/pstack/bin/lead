#!/usr/bin/env bash
# packs/pstack/bin/lead <repo> [--continue] [--dry-run] (#163): starts the pstack Lead of one onboarded repository, an interactive
# claude session in ~/WORKSPACES/<repo> on the repository's own profile. It runs the repository's .gate/bin/setup, installs the
# plugins the repository's own .claude/settings.json enables (never adds a pin) and execs `direnv exec . claude`. It never logs in.
# --dry-run prints the folder, the plugin plan and the command, and runs nothing. Exits 2 on a refusal. See lead.mjs.
exec node "$(dirname "$0")/lead.mjs" "$@"
