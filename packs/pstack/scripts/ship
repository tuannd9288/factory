#!/usr/bin/env bash
# Step 4 of "How a change lands", one command, idempotent on the branch: each run finds the branch's pull request, or
# opens one, and takes the next step. It refuses a wrong step with the reason; it never refuses a push.
#   scripts/ship [--body-file <file>] [--title <title>] [--base <parent-branch>]
# 1. no pull request: opens it, only when origin's copy of the branch is HEAD (push first; the same before arming) and HEAD
#    has a red-check stamp against origin/main (.gate/bin/red-check leaves it in the git dir; the full suite runs on CI);
#    the body is --body-file, with `Closes #<issue>` filled in.
#    --base opens a child on its parent's branch when origin/main's .gate/driver.json has stacks absent or "pstack";
#    "off" keeps the main-only refusal. A child waits unarmed until its parent merges into main, then ship retargets it
#    and rebases past the parent onto origin/main: push with --force-with-lease, then run ship again. With merge set to
#    "merge", it merges origin/main instead and asks for a normal push. An old verdict survives only when the patch-id matches.
# 2. an armed pull request whose HEAD is past what was verified, or no longer covered: disarms it first.
# 3. stops while the pull request carries needs-human; arms a tier 3 (labels, or .gate/bin/tier on the paths) by the same
#    rule, then stops with "tier 3 waits for the Human's approval (unless the merge switch is at all)" until its tier
#    check ends.
# 4. origin/main's .gate/driver.json selects merge: absent or "squash" arms --auto --squash; "merge" arms --auto --merge.
#    Runs scripts/live-verify <pr>, and arms only on PASS or PASS+NOTES (with no driver on main: the author's "no driver" note in place of a verdict) and a base of main;
#    when scripts/live-verify --covered already passes, it arms again without a new run.
# 5. stops, just before arming and on a fresh read, on a pull request that is ready to merge (gh would merge it), and
#    when GitHub refuses the arm because auto-merge is off: the Human merges it.
# Exit 0 a step taken or nothing to do, 1 refused or stopped, 2 could not run.
# It runs the lib/ship.mjs beside it: a repository's scripts/lib/ once the pack is installed, or the pack's own source in the factory,
# whose scripts/ship runs this file (FAC-14).
set -uo pipefail
lib="$(cd "$(dirname "$0")" && pwd)/lib/ship.mjs" || exit 2
cd "$(git rev-parse --show-toplevel)" || exit 2
exec node "$lib" "$@"
