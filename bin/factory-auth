#!/usr/bin/env bash
# Every agent profile's login, account and quota in one table (#173); it never logs in, reads a token or changes a profile.
#   bin/factory-auth status [--all] [--json]
# status runs the vendors' own checks (claude auth status, codex login status, gh auth status) for the profiles of the place it
# runs in (factory when the user is factory, else macbook), and takes quota and live sessions from the seats' run logs. --all,
# on the MacBook, adds the factory rows and the piggery rows over ssh to the Mac mini. --json prints the rows as one JSON line.
# A row that is not logged in shows its login command; the Human runs it. The profiles are committed in lib/auth.mjs, with no account name;
# the account a profile is expected to have is in $FACTORY_STATE/accounts (default ~/.local/state/factory/accounts), one
# "<profile>=<name>" a line, local to the machine, and FACTORY_SEAT_ACCOUNTS ("1=name,2=name") still names the seats' accounts.
# A call that takes longer than FACTORY_AUTH_TIMEOUT_MS (default 15000) is shown as timed out.
exec node "$(dirname "$0")/lib/auth.mjs" "$@"
