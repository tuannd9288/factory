#!/usr/bin/env bash
# The factory's ledger and weekly digest, read from GitHub, the records of bin/seat (FACTORY_STATE/sessions.jsonl) and the --profile-dir folders; no model runs.
#   bin/factory-ledger [--repo owner/name]... [--since YYYY-MM-DD] [--until YYYY-MM-DD] [--rows | --digest]
#                      [--post owner/name] [--profile-dir <dir>]...
#   bin/factory-ledger --check [--latest N] [--profile-dir <dir>]...
#   bin/factory-ledger --quota [--statusline <file>]...
# --quota prints each seat's five-hour and seven-day windows (#63), as Claude Code itself reports them: the newest
# rate_limit_event in the run logs under FACTORY_RUNS (default ~/factory-runs), and the last rate_limits record of each
# status-line file given by --statusline or FACTORY_STATUSLINE (colon-separated). It reads no credential or profile, and
# the digest carries the same table. FACTORY_SEAT_ACCOUNTS ("1=name,2=name") names the accounts in the digest's role map.
# --rows prints one tab-separated row per task (one pull request opened in the window); --digest (the default) prints
# the digest; --post files it as an issue labelled "digest" in the named repository (the factory's own).
# --check is the canary: over the latest N assistant entries of the --profile-dir
# folders it lists the key paths with their types (opening only message and message.usage) and names the fields the
# ledger reads that are missing, or stale (absent from the newest session file or the newest 10 entries); it prints no
# value, counts the entries of the extra folders that record no cwd, and exits 1 on a missing or stale field.
# Without --repo it reads every repository under FACTORY_ROOT (default: this clone) that has joined.
exec node "$(dirname "$0")/lib/ledger.mjs" "$@"
