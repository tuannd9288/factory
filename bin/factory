#!/usr/bin/env bash
# The one command for the Human's agent accounts (#177; its list is #173's).
#   factory account list [--all] [--json]       every agent profile's login, account and plan in a table, each account's quota in a second one; on the Mac mini
#                                  the rows are the teams, numbered and the accounts lettered, with 5h, 7d, reset and the rows that share each (#178)
#   factory account add <account> [--node <node>] [--no-setup]   runs `claude setup-token`, takes the token from a hidden prompt, stores it
#   factory store <account>        on this node: reads one token from stdin and stores it (what account add runs over ssh)
#   factory use [--node <node>] [<row|repo-team> [<letter>]]  the row's account in the accounts file of the node the team runs on becomes the
#                                  letter's: on the MacBook a <repo>-<team> of its own file (nothing restarts; the --here Lead takes it at its next
#                                  start), any other row on the Mac mini; --node macbook makes a MacBook team's first line (#366). On the Mac mini
#                                  the team's next seat session takes it; <repo>-<team> makes the row of a team of an onboarded repository or of the
#                                  factory, and that team's running Lead alone is restarted once Herdr reports it idle (#179, #196, #311)
#   factory lead <repo> [--team <name>] [--new] [--dry-run]  starts the Lead of one team of a repository (use the only team, pick a nickname if none, refuse if several; --new-team picks a free nickname, #416)
#   factory lead <repo> [--team <name>] --here [-- <claude arguments>]  on the MacBook only (#349): claude in this terminal and folder as
#                                  the Lead of <repo>, with an empty GH_CONFIG_DIR, empty GH_TOKEN and GITHUB_TOKEN, the agents' git identity
#                                  (read from the Mac mini's git settings), no git credential helper, a push to GitHub over HTTPS that
#                                  fails and git over ssh off, set through --settings; on the team's own profile and token, in auto mode with
#                                  the Mac mini trusted by the classifier, and the folder trusted in the profile (#366); what follows -- goes to claude.
#                                  With the agents' GitHub token in this node's token store (factory store <agents account>, #366), gh and pushes
#                                  run here instead: the token in claude's environment only, a credential helper for https://github.com, and the
#                                  git identity read from GitHub with that token, so the team ships with the Mac mini off
#   factory gh <gh arguments>      on the MacBook: gh on the Mac mini by ssh under the agents' login, in a new temporary folder there, removed after, stdin
#                                  and exit code kept; refuses gh auth but status (and its -t / --show-token), --recover, and a file given with
#                                  --body-file, --notes-file, --env-file, --input, --field or -F (pass it on stdin: --body-file -, -F name=@-,
#                                  --input -); on the Mac mini it runs gh itself (#349); with the agents' GitHub token in this node's own
#                                  token store, gh runs here with it, refusing only the gh auth commands above (#366); by ssh,
#                                  --body-file <file> is read here and sent on stdin (FAC-79)
#   factory linear <verb> ...      a Lead's steps on a repository on Linear (#404; bin/lib/linear-cli.mjs has the verbs): take, release, read, list, comment, ask,
#                                  answered, create and onboard, as the Factory app; one JSON object on stdout, exit 0, 1 (Linear refused) or 2 (usage); a
#                                  body comes on stdin (--body-file -) or as a file, read here and sent on stdin (FAC-79); it runs on a node whose own token store holds the Factory app's credentials,
#                                  else on the Mac mini by ssh, stdin kept; Colly's decision-create and decision-close always run on the Mac mini
#   factory codex --role <role> [--effort <e>] [--write <folder>]  a pstack step that asks for another model family, on Codex on the verifier's
#                                  profile, never on Claude (#182; packs/pstack/bin/codex-step.mjs has the roles and the rest): the brief on stdin,
#                                  Codex's answer on stdout; exit 3 when it waits for Codex (logged out, out of quota, failed), logged with its
#                                  cause in ~/.local/state/factory/codex-waits.jsonl; on the MacBook it runs on the Mac mini by ssh, in a new temporary folder
#   factory wake <repo> --issue <n> [--team <name>]  wakes the Lead of a team (#351): one line into its Claude Code inbox socket, which says to re-read
#                                  the issue (the message itself is a comment there) and types nothing into its pane; on the Mac mini it posts to the socket
#                                  its hook recorded in ~/factory-runs/<repo>-<team>/socket; on the MacBook to the socket `lead --here` recorded when that
#                                  team's Lead runs there, else the same command runs on the Mac mini by ssh; exit 0 posted, 1 not posted (with the reason), 2 usage
#   factory events --follow [--local] [--after <seq>]  Colly's Monitor on the events (FAC-79): from the MacBook, bin/factory-events --follow on the Mac
#                                  mini by ssh; with --local, on this MacBook's share; only these words, each once, and --after a whole number
#   factory ship [<ship's arguments>] | factory pr-body <n> <file>  the --here Lead's ship and pr-body (FAC-79): the pack's scripts/ship or
#                                  scripts/pr-body beside this command, run in the working folder outside the Lead's sandbox with this node's
#                                  agents login; only in a clone of tuannd9288/factory, read from the folder's origin with the caller's GIT_*
#                                  and GH_* variables dropped, and gh held to that repository; git with no hooks, no fsmonitor, no lazy fetch
#                                  and https alone; exit 2 refused, else the script's code; no pacing of its own (FAC-109)
#   factory account remove <account>       on this node: moves the account's token into ~/.agent-profiles/archive/tokens, never deleting it
# The list runs the vendors' own checks (claude auth status, codex login status, gh auth status) for the profiles of the place
# it runs in (factory when the user is FACTORY_HOST_USER, default factory, else macbook), and takes each account's quota from the run logs of its sessions. On the
# MacBook a plain run is --all (still accepted; refused on the host), and its spare Claude rows are the ~/.claude-acc<N> folders that exist. --all
# adds the factory rows and the piggery rows over ssh to the Mac mini. --json prints the rows as one JSON line.
# A row that is not logged in shows its login command; the Human runs it. The profiles are committed in lib/factory.mjs, with no
# account name; the account of a profile is in $FACTORY_STATE/accounts (default ~/.local/state/factory/accounts), one
# "<profile>=<name>" a line, local to the machine, mode 600: on the Mac mini the one source of a row's account. Only `use` changes it,
# run by the Human or Colly on his spoken word (INN-30, 2026-11-05).
# A call that takes longer than FACTORY_TIMEOUT_MS (default 15000) is shown as timed out.
# Tokens are stored at ~/.agent-profiles/tokens/<account> (mode 600, in a folder of mode 700); only the Human runs account add (bin/install-factory
# puts this command on his PATH, as a symlink into the machine's installed copy of the factory, which follows main and is followed here, #390).
# On the Mac mini the table is the numbered rows (one for each team $FACTORY_STATE/accounts names, factory/<repo>-<team> of an
# onboarded repository or of `factory`, sorted; no seat row; the verifier) and the lettered accounts (every account the file
# names and every file of ~/.agent-profiles/tokens/, read by name and by mode and date only), each with its 5h, 7d, reset, the
# rows that share it, and `?` where no run of the account reported; a row whose account has no token file is red with the line to
# run. $FACTORY_STATE/accounts (<profile>=<account> a line, mode 600, written through a temporary file and a rename) is the one
# source of a row's account (#178). `factory use <row> <letter>` rewrites it (from the MacBook, `use` runs on the Mac
# mini over ssh, its arguments checked first, `ssh -t` when `use` lacks one, unless the row is a <repo>-<team> of the MacBook's own
# accounts file or --node macbook is given: then it writes the MacBook's file, its letters are the MacBook's own token files, and
# `use --node macbook` on the Mac mini is refused; with an argument missing: on a terminal the list and a question, else the list
# and exit 2); the verifier's row is refused; `<repo>-<team>` in a row's place names a team of an
# onboarded repository, or of `factory`, and makes its row when there is none (`use lead-<repo>` is gone); only that team's Lead,
# if it runs (a `claude` process with `--name <repo>-<team>`, the shared Lead process rule), is restarted, once Herdr reports it
# idle or done (its pane is in <repo>-<team>/pane): `/exit`, then `packs/pstack/bin/lead <repo> [--team <team>]` again in the same
# pane, which resumes the conversation (#179, #196, #311), and the other teams are not touched; a Lead that does not run takes the
# account at its next start, exit 0; a busy or blocked Lead, or one with no pane, keeps running and `use` says so, exit 1, and so
# does one that Claude Code's exit dialog for background work holds after `/exit` (Herdr reports it `blocked`): `use` sends Esc,
# starts nothing, and says the Lead keeps running on its old account until its next start while its new workers start on the new
# one (#315); the team's next seat session takes the new account.
# `factory account remove <account>` moves tokens/<account> to ~/.agent-profiles/archive/tokens/<UTC stamp>-<account> (folder 700, by
# rename, never deleting it); its rows then start nothing. Seat 1's old seats/1/oauth-token moves to archive/seat-1/ at the next
# `account add` or `use` once seat 1's account has a token.
# `factory account add <account>` runs `claude setup-token` on his terminal, takes the token from a hidden prompt he pastes into
# (--no-setup skips setup-token). --node defaults to this machine; macbook and tuans-mac-mini name the nodes.
# A token has no whitespace, so account add and store take every space and line break out of what they read: a token pasted from
# a wrapped terminal line is stored whole. The prompt turns on bracketed paste and reads until an Enter followed by 200 ms of quiet,
# so a paste whose line breaks fall between chunks is read whole and none of it is left for the shell (#366).
# For another node, ssh sends the token only on stdin to its factory store; no token goes in arguments or files outside the store.
# Each node owns its store. Leads and seats use only their node's tokens. account remove archives only the local token.
# account add records the UTC added date in tokens/.<account>.added (mode 600), with no token in that file.
# account list shows the added date and its one-year expiry per node (Anthropic authentication page, captured 2026-11-06, line 295).
# It warns within seven days of expiry and when expired; tokens without an added date show "expiry unknown".
# Dates are UTC; a February 29 anniversary becomes February 28. Replacing a token updates its added date; remove archives both.
# Only the Human runs account add, account remove and store; Colly may run use and lead (INN-30) and account list, which prints no token
# (#365). Seats and Leads deny add, remove, store and use. On the MacBook account list also shows its own teams, each account's letter
# (a spare's too) and the quota each MacBook Lead's status line last showed (#365 B5).
# The old login/logout verbs refuse in one line naming account add/remove; the old table invocation names account list.
# `factory lead`: the team is a letter then at most 31 lowercase letters and digits, chosen from the existing teams or the nickname list, and is the team of its
# claims and pull requests; on the Mac mini it runs packs/pstack/bin/lead, on the MacBook it runs that by ssh (the start is
# described in that file's header).
# `factory colly --line [--width N]` prints one status line and `factory colly --brief [--after <seq>]`
# prints the text of Colly's start hook (#365); both exit 0 when GitHub or the deadline fails (a local failure of the snapshot exits 1) and, from the MacBook, run on the Mac mini by ssh.
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
# After --, node takes no argument as its own, so `--env-file` and the like reach lib/factory.mjs (gh's --env-file is one).
exec node -- "$(cd -P "$(dirname "$src")" && pwd)/lib/factory.mjs" "$@"
