#!/usr/bin/env bash
# The SessionStart hook of the agents' Claude profiles (#24): tells the Human, at once, about every *.failed file in
# $FACTORY_STATE (default ~/.local/state/factory), as the JSON a hook prints; --text prints the plain lines for a
# shell. Prints nothing when none exists or FACTORY_NO_ALERTS=1 is set. Always exits 0.
# Every *.failed file (digest.failed, queue-run.failed, queue-<owner>-<repo>.failed) is told at the start of each Claude session
# in this account, by this hook, which is in each profile's settings.json and in the settings bin/seat passes to every session
# it starts (--settings). The hook in the Supervisor's own settings on the MacBook is installed by Colly, not here.
exec node "$(dirname "$0")/lib/alerts.mjs" "$@"
