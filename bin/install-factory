#!/usr/bin/env bash
# Puts `factory` on the PATH (#177) from the machine's installed copy of the factory (#390), which follows main by itself. The Human runs it,
# once per machine, on the MacBook and as the factory user on the Mac mini; it can be run again.
#   From any clone that is not the installed copy: it makes the installed copy when there is none (git clone --branch main --single-branch of
#   $FACTORY_INSTALL_ORIGIN, default https://github.com/tuannd9288/factory.git, then an empty credential.helper in that clone, so its fetch is
#   anonymous and never reaches the Keychain), else brings it to origin/main by followMain's rules (bin/lib/checkout.mjs); then it runs the
#   installed copy's own bin/install-factory, so the code that does the work is main's. The installed copy is $FACTORY_CHECKOUT, ~/WORKSPACES
#   on the Mac mini, and ${XDG_DATA_HOME:-~/.local/share}/factory/checkout on the MacBook (installedRoot, bin/lib/factory.mjs).
#   From the installed copy: it first follows main by the same rule, and when that moved the copy it runs itself again from the moved copy,
#   once; a refused follow is told and the run goes on with the copy as it is. Then ~/.local/bin/factory becomes a symlink to its bin/factory. It replaces a symlink whose target ends in
#   /bin/factory (the old one into a clone included) and nothing else: a file, a folder or a link to another place is named and left as it is.
#   On the Mac mini, enables this repository's commit-msg hook from this main checkout, unless a hooksPath or executable default hook already exists.
#   On the MacBook only, run as its `factory` user (#366; any other user is refused, exit 1, after the link), it then runs the checks of the
#   relay's job (bin/factory-relay plist) and the queue's (bin/factory-queue plist --daemon), which starts the node's own daemon, as
#   LaunchDaemons run by that user (the queue's check runs one sweep as the agents and is not ready until the node holds their GitHub token:
#   factory store <agents account>), writes their plists to $FACTORY_STATE/plist-wanted/ with each one's sha256, user and program, and prints
#   the numbered steps the Human runs one at a time in his own terminal: his own user's old LaunchAgents out, the loaded jobs out, and one
#   sudo command that installs in /Library/LaunchDaemons only copies it checked against those sha256, and loads them (bin/lib/install-factory.mjs).
#   A plist installed as the copy renders it is left out. It says each step in a line.
# A clone anywhere else, its branches and its uncommitted edits change nothing that runs; only a change that lands on main reaches the copy.
set -euo pipefail
[ "$#" -eq 0 ] || { echo "usage: bin/install-factory" >&2; exit 2; }
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
export PATH
command -v node >/dev/null 2>&1 || { echo "install-factory: node is not on PATH ($PATH)" >&2; exit 127; }
here=$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
helper="$here/bin/lib/install-factory.mjs"
root=$(node "$helper" root)

if [ "$(cd -P "$root" 2>/dev/null && pwd || true)" != "$here" ]; then
  if [ -e "$root/.git" ]; then
    # A refusal is told (and is in queue-checkout.failed); the installed copy, where it was, is still what installs.
    node "$helper" follow || echo "install-factory: going on with the installed copy as it is" >&2
  elif [ -e "$root" ] && [ -n "$(ls -A "$root")" ]; then
    echo "install-factory: $root exists and is not a clone; left as it is" >&2
    exit 1
  else
    origin=${FACTORY_INSTALL_ORIGIN:-https://github.com/tuannd9288/factory.git}
    mkdir -p "$(dirname "$root")"
    # The empty helper and no prompt: the first clone is anonymous too, and never reaches the Keychain or asks for a login.
    GIT_TERMINAL_PROMPT=0 git -c credential.helper= clone -q --branch main --single-branch "$origin" "$root"
    git -C "$root" config credential.helper ''
    echo "install-factory: cloned $origin to $root"
  fi
  [ -x "$root/bin/install-factory" ] || { echo "install-factory: $root has no bin/install-factory to run" >&2; exit 1; }
  FACTORY_INSTALL_FOLLOWED=1 exec "$root/bin/install-factory"
elif [ -z "${FACTORY_INSTALL_FOLLOWED:-}" ]; then
  # The copy's own run follows main first, by the same rule; when that moved it, it runs itself again from the moved copy, once.
  before=$(git -C "$here" rev-parse HEAD 2>/dev/null || true)
  node "$helper" follow || echo "install-factory: going on with the installed copy as it is" >&2
  after=$(git -C "$here" rev-parse HEAD 2>/dev/null || true)
  if [ "$before" != "$after" ]; then
    FACTORY_INSTALL_FOLLOWED=1 exec "$here/bin/install-factory"
  fi
fi

target=$here/bin/factory
link=$HOME/.local/bin/factory
if [ -L "$link" ]; then
  case "$(readlink "$link")" in
    */bin/factory) [ "$(readlink "$link")" = "$target" ] || { rm "$link"; ln -s "$target" "$link"; } ;;
    *) echo "install-factory: $link is a link to $(readlink "$link"), not into a factory's bin/factory; left as it is" >&2; exit 1 ;;
  esac
elif [ -e "$link" ]; then
  echo "install-factory: $link exists and is not a link; left as it is" >&2
  exit 1
else
  mkdir -p "$(dirname "$link")"
  ln -s "$target" "$link"
fi
echo "factory: $link -> $target"
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "note: $HOME/.local/bin is not on your PATH" ;; esac

if [ "$(node "$helper" place)" != macbook ]; then
  if hooks=$(git -C "$here" config --show-origin --get core.hooksPath); then
    echo "install-factory: core.hooksPath already set ($hooks); left as it is"
    exit 0
  fi
  hooks=$(git -C "$here" rev-parse --git-path hooks)
  case "$hooks" in /*) ;; *) hooks=$here/$hooks ;; esac
  for hook in "$hooks"/*; do
    case "$hook" in *.sample) continue ;; esac
    if [ -f "$hook" ] && [ -x "$hook" ]; then
      echo "install-factory: existing hook $hook; left as it is"
      exit 0
    fi
  done
  git -C "$here" config --local core.hooksPath "$here/.githooks"
  echo "install-factory: core.hooksPath set to $here/.githooks"
  exit 0
fi
# #366: the relay's job and the queue's (which starts the node's own daemon, as the agents with the node's token), as LaunchDaemons run by
# this user, so they run with nobody logged in: their checks, their plists, and the steps the Human runs (bin/lib/install-factory.mjs).
exec node "$helper" daemons
