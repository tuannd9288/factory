#!/usr/bin/env bash
# Takes a repository into the factory: clones it under the factory root, creates its Claude Code profile (only now)
# with a settings.json that keeps out what the logged-in claude.ai account would load, writes its .envrc, and opens the kit pull request in it once the full verify passes. Logging into the profile stays
# the Human's.
#   bin/onboard <repo-url> [--no-pr] [--own <file>] [--module <name>]...
# The team that claimed the issue runs it; a repository that already has the kit is brought up to date with
# bin/kit-update. bin/onboard-owner runs first; without --no-pr, onboard refuses until
# main carries its pull request rule, and refuses any gh login but the agents' account, which authors the kit PR.
# The repository keeps its own AGENTS.md and CLAUDE.md. The kit puts one marked Gate block at the start of AGENTS.md, after
# an optional title line (kit/.gate/bin/lib/instructions.mjs compose), and writes the one-line import where there is no
# CLAUDE.md. A composed file over 150 lines or 32 KiB, a Gate marker that is malformed, CRLF, or a CLAUDE.md that does not
# reach AGENTS.md is refused: the clone is removed and nothing is cut or rewritten. --own <file> is a complete AGENTS.md the
# repository prepared, used in place of the clone's. Every other file the repository already has is kept, byte for byte:
# the kit ships no scripts/ file of a repository's and no .githooks/, so its own scripts/verify, helpers and hooks stay.
# A repository with its own scripts/verify gets the adapter lines at the end of the .gate/config.sh the kit lays
# (bin/lib/adapter.mjs): GATE_NATIVE names the verify, and gate_fast calls its .githooks/pre-commit. A .claude/settings.json
# it has gets the kit's deny lines it lacks inserted as text (bin/lib/settings.mjs), every other byte kept; a shape that
# cannot take them is refused before anything is written and the clone removed. With none, the kit's own file is laid as it
# is: deny lines only, and no way of working's pin (a team brings that in its own pull request).
# --module <name> (repeatable) turns on a module (modules/<name>/, bin/lib/module.mjs): its files are copied into the
# repository, and only into one that turns it on; the choice is written to .gate/modules, the default being the
# repository's own .gate/modules, else none. A file the repository already has at a module's path is a conflict.
# FACTORY_ROOT (default: this clone) is where repositories live; AGENT_PROFILES (default: ~/.agent-profiles) where
# profiles live, as <owner>/<repo>/claude so two owners' repositories of one name never share one; FACTORY_HUMAN
# (default: tuannd9288) is the code owner of tier 3; FACTORY_AGENT (default: tuan9288-agent) the agents' account.
set -euo pipefail
factory=$(cd "$(dirname "$0")/.." && pwd)
root=${FACTORY_ROOT:-$factory}
profiles=${AGENT_PROFILES:-$HOME/.agent-profiles}
human=${FACTORY_HUMAN:-tuannd9288}
agent=${FACTORY_AGENT:-tuan9288-agent}
url=${1:?usage: bin/onboard <repo-url> [--no-pr] [--own <file>] [--module <name>]...}
shift
open_pr=1
own=""
modules=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-pr) open_pr=0; shift ;;
    --own) own=${2:?onboard: --own needs a file}; shift 2 ;;
    --module) modules+=("${2:?onboard: --module needs a name}"); shift 2 ;;
    *) echo "onboard: unknown argument $1; nothing done"; exit 2 ;;
  esac
done
path=${url%/}
path=${path%.git}
name=$(basename "$path")
owner=$(basename "$(dirname "$path")")
owner=${owner##*:}
dest=$root/$name
[ -e "$dest" ] && { echo "onboard: $dest exists; nothing done"; exit 1; }
# A module the factory lacks, or one that lays a kit file, is refused before anything is cloned.
if [ "${#modules[@]}" -gt 0 ]; then
  why=$(node "$factory/bin/lib/module.mjs" check "$factory" "${modules[@]}" 2>&1) || { echo "onboard: $why; nothing done"; exit 2; }
fi
# The AGENTS.md the repository gets is its own text with the kit's block in it: the 150 lines and 32 KiB count both. A
# --own file is checked now, before anything is cloned; the clone's own is checked after the clone.
composed=$(mktemp)
trap 'rm -f "$composed"' EXIT
instructions="$factory/kit/.gate/bin/lib/instructions.mjs"
section="$factory/kit/.gate/gate-section.md"
if [ -n "$own" ]; then
  [ -f "$own" ] || { echo "onboard: --own $own is not a file; nothing done"; exit 2; }
  own=$(cd "$(dirname "$own")" && pwd)/$(basename "$own")
  why=$(node "$instructions" compose --section "$section" --name "$name" --agents "$own" 2>&1 >"$composed") || { echo "onboard: --own $own: $why; nothing done"; exit 2; }
fi
if [ "$open_pr" -eq 1 ]; then
  login=$(gh api user --jq .login)
  lc() { tr '[:upper:]' '[:lower:]' <<<"$1"; }
  if [ "$(lc "$login")" != "$(lc "$agent")" ]; then
    echo "onboard: opens the kit pull request as the agents' account ($agent), not as $login; nothing done"
    exit 2
  fi
  if ! gh api "repos/$owner/$name/rules/branches/main" | grep -Eq '"type": ?"pull_request"'; then
    echo "onboard: main has no pull request rule: bin/onboard-owner runs first (Colly, on the Human's login)"
    echo "onboard: nothing done"
    exit 2
  fi
  # The kit is laid from this clone's working tree, and its evidence names a commit: the two must be one, on main.
  if git -C "$factory" status --porcelain --ignored --untracked-files=all -- kit packs modules | grep -v '\.DS_Store$' | grep -q .; then
    echo "onboard: the factory's kit has changes no commit holds (kit/, packs/ and modules/); commit and push them first; nothing done"
    exit 2
  fi
  kit_commit=$(git -C "$factory" rev-parse HEAD)
  # On the first-parent line of origin/main: a commit a merge brought in from a side branch is not one main recorded.
  first_parent=$(git -C "$factory" rev-list --first-parent refs/remotes/origin/main 2>/dev/null) || first_parent=""
  if ! grep -Fxq "$kit_commit" <<<"$first_parent"; then
    echo "onboard: the factory's commit ${kit_commit:0:7} is not on its origin/main (its first-parent line); push it first; nothing done"
    exit 2
  fi
fi

echo "onboard: cloning $url into $dest"
git clone --quiet "$url" "$dest"
# The modules are the repository's own choice unless --module says: one it names that the factory lacks, or whose files
# collide with the kit's, is refused like a --module given, and a file the repository has at a module's path is a
# conflict. $dest did not exist before this run, so the clone is this run's own to remove.
if [ "${#modules[@]}" -eq 0 ] && [ -f "$dest/.gate/modules" ]; then
  why=$(node "$factory/bin/lib/module.mjs" names "$dest/.gate/modules" 2>&1) || { rm -rf "$dest"; echo "onboard: $why; the clone is removed and nothing else was done"; exit 2; }
  while IFS= read -r m; do [ -z "$m" ] || modules+=("$m"); done <<<"$why"
fi
module_files=$(mktemp)
trap 'rm -f "$composed" "$module_files"' EXIT
if [ "${#modules[@]}" -gt 0 ]; then
  why=$(node "$factory/bin/lib/module.mjs" files "$factory" "${modules[@]}" 2>&1 >"$module_files") || { rm -rf "$dest"; echo "onboard: .gate/modules: $why; the clone is removed and nothing else was done"; exit 2; }
  while IFS=$'\t' read -r path m; do
    if [ -e "$dest/$path" ] || [ -L "$dest/$path" ]; then
      rm -rf "$dest"
      echo "onboard: $path is the repository's own file and module $m lays it; the clone is removed and nothing else was done"
      exit 2
    fi
  done <"$module_files"
fi
# The repository keeps its own AGENTS.md and CLAUDE.md. The AGENTS.md it gets is checked now, before anything is written:
# one over the limits, with malformed markers or CRLF, or a CLAUDE.md that does not reach it, is refused and the clone,
# which this run made, is removed. A file of the repository's is never cut, rewritten or replaced.
# A link or a folder at AGENTS.md is refused with --own too: the kit writes the file in place, and neither writes through a
# link nor replaces one (the evidence would fail a mode that changed from 120000).
if { [ -e "$dest/AGENTS.md" ] || [ -L "$dest/AGENTS.md" ]; } && { [ -L "$dest/AGENTS.md" ] || [ ! -f "$dest/AGENTS.md" ]; }; then
  rm -rf "$dest"
  echo "onboard: AGENTS.md is a link or not a regular file, which the kit will not write through or replace, with --own as without it; the clone is removed and nothing else was done"
  exit 2
fi
if [ -z "$own" ]; then
  compose_args=(compose --section "$section" --name "$name")
  { [ -e "$dest/AGENTS.md" ] || [ -L "$dest/AGENTS.md" ]; } && compose_args+=(--agents "$dest/AGENTS.md")
  why=$(node "$instructions" "${compose_args[@]}" 2>&1 >"$composed") || { rm -rf "$dest"; echo "onboard: $why; the clone is removed and nothing else was done"; exit 2; }
fi
if [ -e "$dest/CLAUDE.md" ] || [ -L "$dest/CLAUDE.md" ]; then
  why=$(node "$instructions" carrier "$dest/CLAUDE.md" 2>&1) || { rm -rf "$dest"; echo "onboard: $why; the clone is removed and nothing else was done"; exit 2; }
fi
kit_commit=$(git -C "$factory" rev-parse HEAD)
# The repository's own .claude/settings.json gets the kit's deny lines as text (bin/lib/settings.mjs); a shape the lines
# cannot be added to without touching other bytes is told now, before anything is written.
if { [ -e "$dest/.claude/settings.json" ] || [ -L "$dest/.claude/settings.json" ]; } && { [ -L "$dest/.claude/settings.json" ] || [ ! -f "$dest/.claude/settings.json" ]; }; then
  rm -rf "$dest"
  echo "onboard: .claude/settings.json is not a regular file (a link or a directory), and the kit will not write through or into it; the clone is removed and nothing else was done"
  exit 2
fi
if [ -f "$dest/.claude/settings.json" ]; then
  trial=$(mktemp)
  cp "$dest/.claude/settings.json" "$trial"
  if ! why=$(node "$factory/bin/lib/settings.mjs" add "$trial" "$factory/kit/.claude/settings.json"); then
    rm -rf "$dest" "$trial"
    echo "onboard: .claude/settings.json: ${why#settings: $trial: }; the clone is removed and nothing else was done"
    exit 2
  fi
  rm -f "$trial"
fi

profile=$profiles/$owner/$name/claude
# The profile's settings.json is the one place that turns off what the claude.ai account loads into every session: its
# connectors, and the skills and plugins it syncs, which a repository's .claude/settings.json cannot turn off (#30).
# It also keeps Claude Code on the stable update channel, and runs bin/factory-alerts when a session starts, so the
# Human hears of every *.failed file in the state folder at once (#24). The hook's path is this clone's, absolute.
keys=$(node -e 'console.log(JSON.stringify({
  disableClaudeAiConnectors: true,
  syncClaudeAiSkills: false,
  syncClaudeAiPlugins: false,
  autoUpdatesChannel: "stable",
  hooks: { SessionStart: [{ matcher: "startup|resume", hooks: [{ type: "command", command: process.argv[1] + "/bin/factory-alerts", timeout: 10 }] }] },
}, null, 2))' "$factory")
if [ -e "$profile" ]; then
  echo "onboard: profile $profile exists and is kept; only the Human edits it, and its settings.json needs these keys:"
  printf '%s\n' "$keys"
else
  mkdir -p "$profile"
  printf '%s\n' "$keys" >"$profile/settings.json"
  echo "onboard: profile $profile, with a settings.json that turns off claude.ai's connectors and synced skills and plugins, stays on the stable channel and runs bin/factory-alerts at session start"
fi
shown=$profile
[ "$profiles" = "$HOME/.agent-profiles" ] && shown="\$HOME/.agent-profiles/$owner/$name/claude"
line="export CLAUDE_CONFIG_DIR=\"$shown\""
if [ -e "$dest/.envrc" ]; then
  echo "onboard: $dest/.envrc exists and is kept; add to it: $line"
else
  echo "$line" >"$dest/.envrc"
  grep -qx '.envrc' "$dest/.git/info/exclude" 2>/dev/null || echo '.envrc' >>"$dest/.git/info/exclude"
  if command -v direnv >/dev/null; then direnv allow "$dest"; else echo "onboard: direnv is not installed; run 'direnv allow' in $dest later"; fi
fi
# Claude Code's worktrees sit under .claude/worktrees/, inside the tier-3 path .claude/; they find the .envrc above.
grep -qx '.claude/worktrees/' "$dest/.git/info/exclude" 2>/dev/null || echo '.claude/worktrees/' >>"$dest/.git/info/exclude"

cd "$dest"
base=$(git rev-parse HEAD)
git switch --quiet -c factory/kit
lists=$(mktemp -d)
trap 'rm -rf "$lists"; rm -f "$composed" "$module_files"' EXIT
(cd "$factory/kit" && find . -type f ! -name .DS_Store | sed 's#^\./##' | LC_ALL=C sort) >"$lists/kit"
: >"$lists/kept"
: >"$lists/replaced"
: >"$lists/merged"
had_config=0
[ -e .gate/config.sh ] && had_config=1
while IFS= read -r path; do
  if [ -e "$path" ] || [ -L "$path" ]; then
    case "$path" in
      .claude/settings.json)
        # The repository's own file keeps every byte; the kit's deny lines it lacks are inserted (checked above).
        node "$factory/bin/lib/settings.mjs" add "$path" "$factory/kit/$path" >/dev/null
        echo "$path" >>"$lists/merged"
        continue
        ;;
      *)
        echo "$path" >>"$lists/kept"
        continue
        ;;
    esac
  fi
  mkdir -p "$(dirname "$path")"
  cp -p "$factory/kit/$path" "$path"
  case "$path" in
    .github/CODEOWNERS) sed -i.bak "s/@OWNER/@$human/" "$path" && rm -f "$path.bak" ;;
  esac
done <"$lists/kit"
# The instruction files: AGENTS.md is the composed text (the repository's own, or --own, with the block in it) written over
# the file in place, so its mode stays; CLAUDE.md is the repository's own, or the one-line import where it had none.
[ ! -e AGENTS.md ] || echo AGENTS.md >>"$lists/merged"
cat "$composed" >AGENTS.md
[ -e CLAUDE.md ] || [ -L CLAUDE.md ] || printf '@AGENTS.md\n' >CLAUDE.md
# A repository with its own scripts/verify gets the adapter lines (bin/lib/adapter.mjs), but only in a .gate/config.sh the
# kit has just laid: one the repository had is its own.
[ "$had_config" -eq 1 ] || node "$factory/bin/lib/adapter.mjs" "$dest" >>.gate/config.sh
# A module's files go in after the kit's: none of them is at a path the repository or the kit has (checked above).
while IFS=$'\t' read -r path m; do
  mkdir -p "$(dirname "$path")"
  cp -p "$factory/modules/$m/kit/$path" "$path"
done <"$module_files"
# A file the repository had exactly as the kit's was not replaced: git sees no change in it.
while IFS= read -r path; do git diff --quiet HEAD -- "$path" || echo "$path"; done <"$lists/replaced" >"$lists/changed"
mv "$lists/changed" "$lists/replaced"
# .gate/kit-commit (the factory commit the kit came from), .gate/kit-files (the inventory) and .gate/modules are generated
# here, not files of the kit. Removed first: a link the repository holds there would take the write outside the clone. The
# inventory lists neither AGENTS.md nor CLAUDE.md: they are the repository's own.
rm -f .gate/kit-commit .gate/kit-files .gate/modules
printf '%s\n' "$kit_commit" >.gate/kit-commit
[ "${#modules[@]}" -eq 0 ] || printf '%s\n' "${modules[@]}" | LC_ALL=C sort -u >.gate/modules
{ cat "$lists/kit"; cut -f1 "$module_files"; echo .gate/kit-files; echo .gate/kit-commit; [ ! -f .gate/modules ] || echo .gate/modules; } | LC_ALL=C sort -u >.gate/kit-files
.gate/bin/setup
git add -A
# The kit lands only on a repository where the whole gate passes: a commit nobody verified is not a kit pull request.
if ! GATE_BASE=HEAD .gate/bin/verify; then
  echo "onboard: the kit is staged on factory/kit, not committed: .gate/bin/verify fails. Fill .gate/config.sh (test"
  echo "command, fast checks), merge the files the repository already had, run .gate/bin/verify, then commit and open"
  echo "the pull request."
  exit 1
fi
n_kept=$(wc -l <"$lists/kept" | tr -d ' ')
git commit --quiet -m "Join the factory: gate, hooks, hand-in rules and templates" \
  -m "From tuannd9288/factory $(git -C "$factory" rev-parse --short HEAD 2>/dev/null || echo '(uncommitted)'). Kept as the repository had them: $n_kept. Its AGENTS.md has the kit's Gate block at the start; the rest of it, and its CLAUDE.md, are its own."
echo "onboard: kit committed on factory/kit ($(wc -l <"$lists/kit" | tr -d ' ') files, $n_kept kept as they were; AGENTS.md has the Gate block, the rest of it is the repository's)"

[ "$open_pr" -eq 1 ] || { echo "onboard: --no-pr; push factory/kit and open the pull request yourself"; exit 0; }

slug=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
id=$(gh api "repos/$slug" --jq .id)
head=$(git rev-parse HEAD)
if ! evidence=$("$factory/bin/kit-evidence" --factory "$factory" --commit "$kit_commit" --repo "$dest" --base "$base" \
  --head "$head" --slug "$slug" --id "$id" --human "$human" ${own:+--own}) || ! grep -qx 'kit-evidence: PASS' <<<"$evidence"; then
  printf '%s\n' "$evidence"
  echo "onboard: the kit evidence fails; factory/kit is committed, not pushed, and no pull request is open"
  exit 1
fi
for label in tier-1 tier-2 tier-3 needs-human raised task; do gh label create "$label" --repo "$slug" --force >/dev/null; done
git push --quiet -u origin factory/kit
kept=$(sed 's/^/  - `/; s/$/`/' "$lists/kept")
moved=""
moved='The repository'"'"'s own `AGENTS.md` has the kit'"'"'s marked `## Gate` block inserted at its start, after the title line; every other byte of it is the repository'"'"'s, and so is its `CLAUDE.md` (the import is written only where there was none).'
[ -z "$own" ] || moved="$moved"' The `AGENTS.md` came in through `--own`: the evidence below prints its text in full.'
# The repository's own scripts/ and hooks, which the kit does not ship and leaves byte for byte (the evidence checks it).
untouched=$(git ls-tree -r --name-only "$base" -- scripts .githooks | grep -vxFf "$lists/kit" || true)
untouched_list=$(printf '%s' "$untouched" | sed '/^$/d; s/^/  - `/; s/$/`/')
grep -qx '.claude/settings.json' "$lists/merged" && moved="${moved:+$moved }The repository's own \`.claude/settings.json\` has the kit's deny lines inserted as text; every other byte is the repository's, and the evidence below names it as merged."
if [ "$had_config" -eq 0 ] && [ -f scripts/verify ]; then
  adapter_note="\`.gate/config.sh\` ends with the adapter lines: \`GATE_NATIVE=scripts/verify\` runs the repository's own verify as the \`native\` check"
  grep -q '^gate_fast() { \.githooks/pre-commit; }$' .gate/config.sh && adapter_note="$adapter_note, and \`gate_fast\` in \`.gate/config.sh\` calls \`.githooks/pre-commit\`"
  moved="${moved:+$moved }$adapter_note."
fi
[ -z "$untouched" ] || moved="${moved:+$moved }The repository's own hooks stay in \`.githooks/\` and run only in a clone that ran the repository's own setup; the kit's \`.gate/hooks/\` serve a repository with none."
gh pr create --repo "$slug" --head factory/kit --title "Join the factory: gate, hooks, hand-in rules and templates" --body "$(cat <<EOF
## Summary for the Human
- Purpose: bring $name into the factory with the kit of tuannd9288/factory.
- Change: \`.gate/bin/\` (verify, rules, red-check, tier, prove-check, verify-trusted, review, setup), \`.gate/hooks/\`, \`.gate/\` (with \`protected\`: the tier-3 paths), three workflows (gate, gate-trusted, main), the PR template, CODEOWNERS, deny rules, \`.gate/kit-commit\` (the factory commit), the \`## Gate\` block in \`AGENTS.md\` and, where there was none, \`CLAUDE.md\`.
- Evidence: the full \`.gate/bin/verify\` was green before the commit; the kit's files match factory commit \`${kit_commit:0:7}\` (below).
- Tier: 3 (touches \`.github/\`, \`scripts/\`, \`.gate/\`).
- Rollback: revert this PR.
- Needs the Human: yes — confirm \`.gate/load-bearing\` (tier 2) and \`.gate/protected\` (tier 3); recommendation: approve once the repository's session has filled both lists.

## Files the repository already had, kept by the kit (the repository's session merges them by hand)
${kept:-  - none}

## Files the repository already had, left untouched
${untouched_list:-  - none}
${moved:+
$moved
}
## Kit evidence (bin/kit-evidence, the factory's code, reads only git objects)
\`\`\`text
$evidence
\`\`\`
Re-check from the factory's clone: \`bin/kit-evidence --factory <factory> --commit $kit_commit --repo <clone> --base $base --head $head --slug $slug --id $id\`

Note: the \`verify\` check of this PR is red (\`.gate/bin/verify-trusted: No such file\`, code 127) because \`main\` has no kit yet; it does not block the merge, because \`factory-bootstrap\` requires no check.

## After the merge
1. Colly runs \`bin/onboard-owner $slug --id $id --apply\` again, on the Human's login; his approval of this pull
   request covers it. It replaces the temporary ruleset of \`main\` with the kit's \`factory-gate\` and reads back what
   it set.
2. Where the repository uses the kit's Claude reviewer, the Human pastes the reviewer's secret into the environment
   \`reviewer\` (branch \`main\` only; set no repository-level secret: the \`pull_request\` jobs of every branch can
   read it). Entire needs none (#155).
3. Log into the profile: open a new pane in the repository, check \`echo \$CLAUDE_CONFIG_DIR\`, run \`claude\`.

Colly set the repository variables in step 2 of taking the repository in, under the Human's approval. An empty value
means GitHub's runner.
- \`GATE_RUNNER\`: the runner of \`main\`'s jobs.
- \`GATE_PR_RUNNER\`: the runner of the candidate's \`verify\`.
- \`GATE_TRUSTED_RUNNER\`: the runner of the jobs that hold the reviewer's credential. It is never a runner that a
  candidate's, \`main\`'s or a deploy's job uses.
- \`GATE_REVIEWER\`: which reviewer the gate runs. While it is unset, \`review\` and \`verdict\` are red and nothing
  merges itself.

Issue: none
Team: factory/onboard
EOF
)"
