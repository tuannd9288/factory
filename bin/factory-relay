#!/usr/bin/env bash
# The MacBook's relay of a Lead's news (#370, slice 2), run by launchd under the Human's own user:
#   bin/factory-relay run     one pass, then exit: read the Mac mini's news lines by ssh and post each one the Mac mini could not deliver
#                             (no Lead runs there) into the socket file of the Lead that runs on this Mac
#   bin/factory-relay plist   write the clone's committed HEAD into ~/.local/share/factory/relay/<sha>/, point relay/current at it, and print
#                             the LaunchAgent io.github.tuannd9288.factory.relay for ~/Library/LaunchAgents, which runs from relay/current:
#                             `run` every 60 s, no sudo, never KeepAlive, logging to ~/Library/Logs/factory/relay.log
#   bin/factory-relay check   in that job's environment: makes the log's folder, fails when a path of the job (or of the installed plist) sits
#                             under ~/Desktop, ~/Documents, ~/Downloads or ~/Library/Mobile Documents, when the copy is missing, or when the
#                             loaded job's last exit code is not 0, and says whether ssh to the Mac mini (with launchd's SSH_AUTH_SOCK) and
#                             the read of its news work with no prompt, so whether the job is ready; it sets the first cursor, relays nothing
# macOS refuses a launchd job those folders, and the MacBook's clone sits under ~/Desktop: so the job runs from the copy outside them, and
# Full Disk Access is not asked for. An uncommitted change in the clone is not in the copy.
# `plist` and `check` run from the clone itself: they refuse a linked worktree (exit 2) and note a branch other than main.
# bin/lib/relay.mjs has the rules. It calls no gh and reads no token; it refuses to run as the factory host's user, where the sweep delivers.
# The Human installs the job with `bin/factory-relay plist > ~/Library/LaunchAgents/io.github.tuannd9288.factory.relay.plist`, loads it with
# `launchctl bootstrap gui/$(id -u) <that path>` and stops it with `launchctl bootout gui/$(id -u)/io.github.tuannd9288.factory.relay`; to
# replace a loaded job, `bootout` then `bootstrap`. After a pull, `plist` again refreshes the copy; the job needs no reload.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
export PATH
command -v node >/dev/null 2>&1 || { echo "factory-relay: node is not on PATH ($PATH)" >&2; exit 127; }
exec node "$(dirname "$0")/lib/relay.mjs" "$@"
