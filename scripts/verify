#!/usr/bin/env bash
# The factory's own checks: the kit's tests, which show each check failing on a bad input, and the kit's templates.
# Prints only failures and a one-line summary.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
start=$SECONDS
failed=0

# The AGENTS.md a repository gets is the kit's with one pack's section (or none); each must leave room for its own parts.
for pack in none $(ls packs 2>/dev/null); do
  [ "$pack" = none ] || [ -d "packs/$pack" ] || continue
  if ! n=$(node bin/lib/pack.mjs agents . "$pack" | wc -l | tr -d ' ') || [ "${n:-0}" -eq 0 ]; then
    echo "verify: the AGENTS.md of pack $pack cannot be composed"; failed=1
  elif [ "$n" -gt 150 ]; then
    echo "verify: the AGENTS.md of pack $pack has $n lines; at most 150"; failed=1
  fi
done
# The modules together: a file two of them lay, or one the kit lays, or one onboard generates, is refused.
if [ -d modules ] && ! why=$(node bin/lib/module.mjs check . $(ls modules) 2>&1); then
  echo "verify: modules: $why"; failed=1
fi
for f in packs/pstack/scripts/* kit/.gate/bin/* kit/.gate/hooks/* bin/onboard bin/onboard-owner bin/kit-update bin/kit-evidence bin/factory-ledger bin/factory-queue bin/claude-canary bin/factory-alerts scripts/verify; do
  [ -f "$f" ] || continue
  head -1 "$f" | grep -q bash || continue
  bash -n "$f" 2>/dev/null || { echo "verify: $f does not parse"; failed=1; }
done

# On a pull request, the subject of every commit it adds: the kit's own rules, from the same source as the hook.
if [ "${GITHUB_EVENT_NAME:-}" = pull_request ] && [ -z "${GATE_BASE:-}" ]; then
  echo "verify: running on a pull request but GATE_BASE is empty, so no commit subject would be checked"
  exit 1
fi
if [ -n "${GATE_BASE:-}" ]; then
  subjects=$(node kit/.gate/bin/lib/subject.mjs --base "$GATE_BASE" 2>&1) || { echo "verify: a commit subject breaks a rule"; printf '%s\n' "$subjects"; failed=1; }
fi

for f in kit/.github/workflows/*.yml .github/workflows/*.yml; do
  ruby -ryaml -e 'YAML.load_file(ARGV[0])' "$f" >/dev/null 2>&1 || { echo "verify: $f does not parse as YAML"; failed=1; }
done

# The tools keep state in the folders these name, the machine's own by default; direnv, which bin/onboard runs, records
# each folder it allows under XDG_DATA_HOME. The tests get fresh empty ones, so a test that gives a tool no folder of its
# own writes here rather than into the machine's, and the run fails (#35).
folders='FACTORY_STATE AGENT_PROFILES FACTORY_ROOT XDG_DATA_HOME'
sandbox=$(mktemp -d) || { echo "verify: could not make a folder for the tests' state"; exit 2; }
trap 'rm -rf "$sandbox"' EXIT
for v in $folders; do mkdir "$sandbox/$v"; done
out=$(env -u NODE_TEST_CONTEXT FACTORY_STATE="$sandbox/FACTORY_STATE" AGENT_PROFILES="$sandbox/AGENT_PROFILES" \
  FACTORY_ROOT="$sandbox/FACTORY_ROOT" XDG_DATA_HOME="$sandbox/XDG_DATA_HOME" \
  node --test --test-reporter=spec --test-concurrency=4 'test/*.test.mjs' 'packs/*/test/*.test.mjs' 'modules/*/test/*.test.mjs' 2>&1)
code=$?
summary=$(printf '%s\n' "$out" | grep -E '^ℹ (tests|fail) [0-9]+$' | sed 's/^ℹ //' | tr '\n' ' ')
tests=$(printf '%s\n' "$out" | sed -n 's/^ℹ tests \([0-9][0-9]*\)$/\1/p')
if [ "$code" -ne 0 ]; then
  printf '%s\n' "$out" | grep -E -A12 '^\s*✖' | head -80
  echo "verify: the kit's tests failed (${summary% })"
  failed=1
elif [ "${tests:-0}" -eq 0 ]; then
  echo "verify: no tests ran"
  failed=1
fi
for v in $folders; do
  { [ -d "$sandbox/$v" ] && [ ! -L "$sandbox/$v" ]; } || { echo "verify: a test removed or replaced the $v folder it was given"; failed=1; }
done
leaked=$(cd "$sandbox" && find $folders -mindepth 1 \( -type f -o -type l -o -type d -empty \) 2>/dev/null | sort)
if [ -n "$leaked" ]; then
  n=$(printf '%s\n' "$leaked" | wc -l | tr -d ' ')
  echo "verify: a test wrote outside its own folders; give the tool it starts a FACTORY_STATE, AGENT_PROFILES, FACTORY_ROOT or XDG_DATA_HOME of its own:"
  printf '%s\n' "$leaked" | head -20 | sed 's/^/  /'
  [ "$n" -le 20 ] || echo "  and $((n - 20)) more"
  failed=1
fi
[ "$failed" -eq 0 ] || { echo "verify: failed in $((SECONDS - start))s"; exit 1; }
echo "verify: ${tests} tests passed in $((SECONDS - start))s"
